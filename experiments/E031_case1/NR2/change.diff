+__global__ __vector__ void e031_case1_nr2_custom(
+    GM_ADDR x,GM_ADDR residual,GM_ADDR gamma,GM_ADDR bias,GM_ADDR output,float epsilon)
+{
+    using T=half;
+    // CANN 9.0 static Tensor programming: this entry never creates TPipe,
+    // TQue, TBuf, or calls an API with implicit TPipe event allocation.
+    InitSocState();
+    GlobalTensor<T> xgm, rgm, ggm, bgm, outgm;
+    xgm.SetGlobalBuffer((__gm__ T*)x);
+    rgm.SetGlobalBuffer((__gm__ T*)residual);
+    ggm.SetGlobalBuffer((__gm__ T*)gamma);
+    bgm.SetGlobalBuffer((__gm__ T*)bias);
+    outgm.SetGlobalBuffer((__gm__ T*)output);
+    // Byte-addressed UB regions; all starts are 32 B aligned and disjoint.
+    // Each typed input slot reserves 256 B, enough for 64 FP32 elements.
+    LocalTensor<T> xt(TPosition::VECIN, 0, 64);
+    LocalTensor<T> rt(TPosition::VECIN, 256, 64);
+    LocalTensor<T> gt(TPosition::VECIN, 512, 64);
+    LocalTensor<T> bt(TPosition::VECIN, 768, 64);
+    LocalTensor<float> y(TPosition::VECCALC, 1024, 64);
+    LocalTensor<float> tmp(TPosition::VECCALC, 1280, 64);
+    LocalTensor<float> gf(TPosition::VECCALC, 1536, 64);
+    LocalTensor<float> bf(TPosition::VECCALC, 1792, 64);
+    LocalTensor<float> sum(TPosition::VECCALC, 2048, 8);
+    LocalTensor<float> work(TPosition::VECCALC, 2080, 64);
+    LocalTensor<T> result(TPosition::VECOUT, 2336, 64);
+
+    // D64 transfers are exactly 4 blocks (FP16/BF16) or 8 blocks (FP32).
+    // All UB starts and full-vector GM bases are 32 B aligned.
+    DataCopyParams copy = {1, static_cast<uint16_t>(64 * sizeof(T) / 32), 0, 0};
+    DataCopy(xt, xgm, copy);
+    DataCopy(rt, rgm, copy);
+    SetFlag<HardEvent::MTE2_V>(0);
+    DataCopy(gt, ggm, copy);
+    DataCopy(bt, bgm, copy);
+    SetFlag<HardEvent::MTE2_V>(1);
+    WaitFlag<HardEvent::MTE2_V>(0);
+    if (sizeof(T) == sizeof(float)) {
+        // FP32 operands already occupy FP32 UB storage.
+        y = xt.template ReinterpretCast<float>();
+        tmp = rt.template ReinterpretCast<float>();
+        gf = gt.template ReinterpretCast<float>();
+        bf = bt.template ReinterpretCast<float>();
+    } else {
+        if(CompactParameterType<T>::value) {
+            Add(xt,xt,rt,64);PipeBarrier<PIPE_V>();
+            ToFloat<T>(y,xt,64);
+        } else {
+            ToFloat<T>(y,xt,64);ToFloat<T>(tmp,rt,64);
+        }
+        PipeBarrier<PIPE_V>();
+    }
+    if(!CompactParameterType<T>::value) Add(y,y,tmp,64);
+    PipeBarrier<PIPE_V>();
+    Mul(tmp, y, y, 64);
+    PipeBarrier<PIPE_V>();
+    WholeReduceSum(sum, tmp, 64, 1, 1, 1, 8);
+    PipeBarrier<PIPE_V>();
+    Muls(sum, sum, 0.015625f, 1);
+    PipeBarrier<PIPE_V>();
+    Adds(sum, sum, epsilon, 1);
+    PipeBarrier<PIPE_V>();
+    // All operations stay on the vector pipeline. For z=+Inf, native
+    // Rsqrt(z)=0; clamp only the correction operand so 0*Inf cannot
+    // turn that valid zero inverse into NaN. Finite z is unchanged.
+    Rsqrt(work[8],sum,1);
+    Mins(work[16],sum,3.402823466e38f,1);
+    Duplicate(work[24],1.5f,1);
+    PipeBarrier<PIPE_V>();
+    Mul(work[32],work[8],work[8],1);
+    Muls(work[16],work[16],-0.5f,1);
+    PipeBarrier<PIPE_V>();
+    FusedMulAdd(work[32],work[16],work[24],1);PipeBarrier<PIPE_V>();
+    Mul(sum,work[8],work[32],1);PipeBarrier<PIPE_V>();
+    Brcb(work,sum,1,{1,8});PipeBarrier<PIPE_V>();
+    Mul(y,y,work,static_cast<uint64_t>(64),static_cast<uint8_t>(1),
+        {1,1,0,8,8,0});PipeBarrier<PIPE_V>();
+    WaitFlag<HardEvent::MTE2_V>(1);
+    if(sizeof(T)!=sizeof(float)) {
+        ToFloat<T>(gf,gt,64);ToFloat<T>(bf,bt,64);PipeBarrier<PIPE_V>();
+    }
+    FusedMulAdd(y,gf,bf,64);
+    PipeBarrier<PIPE_V>();
+    if (sizeof(T) == sizeof(float)) {
+        // A2 permits a direct VECIN -> GM transfer from the overwritten xt.
+        result = y.template ReinterpretCast<T>();
+    } else {
+        FromFloat<T>(result, y, 64);
+        PipeBarrier<PIPE_V>();
+    }
+    SetFlag<HardEvent::V_MTE3>(1);
+    WaitFlag<HardEvent::V_MTE3>(1);
+    DataCopy(outgm, result, copy);
+    SetFlag<HardEvent::MTE3_V>(2);
+    WaitFlag<HardEvent::MTE3_V>(2);
+}
