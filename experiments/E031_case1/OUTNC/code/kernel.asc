// Static single-row path for D=65..4096. No Pipe framework object or
// API that allocates implicit TPipe events is used by this entry.
template <typename T>
class SingleRowStaticKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint32_t d, float inverseD, float epsilon)
    {
        d_ = d;
        padded_ = (d + 63) / 64 * 64;
        invD_ = inverseD;
        epsilon_ = epsilon;
        xgm_.SetGlobalBuffer((__gm__ T*)x);
        rgm_.SetGlobalBuffer((__gm__ T*)r);
        ggm_.SetGlobalBuffer((__gm__ T*)g);
        bgm_.SetGlobalBuffer((__gm__ T*)b);
        outgm_.SetGlobalBuffer((__gm__ T*)out);
        // Each fixed slot reserves 16384 B, enough for 4096 FP32 elements.
        // Slots are byte-addressed, 32 B aligned, and never exceed UB148000 B.
        x_ = LocalTensor<T>(TPosition::VECIN, 0, padded_);
        r_ = LocalTensor<T>(TPosition::VECIN, 16384, padded_);
        g_ = LocalTensor<T>(TPosition::VECIN, 32768, padded_);
        b_ = LocalTensor<T>(TPosition::VECIN, 49152, padded_);
        y_ = LocalTensor<float>(TPosition::VECOUT, 65536, padded_);
        tmp_ = LocalTensor<float>(TPosition::VECCALC, 81920, padded_);
        gf_ = LocalTensor<float>(TPosition::VECCALC, 98304, padded_);
        bf_ = LocalTensor<float>(TPosition::VECCALC, 114688, padded_);
        result_ = LocalTensor<T>(TPosition::VECOUT, 131072, padded_);
        partials_ = LocalTensor<float>(TPosition::VECCALC, 147456, 64);
        sum_ = LocalTensor<float>(TPosition::VECCALC, 147712, 8);
        work_ = LocalTensor<float>(TPosition::VECCALC, 147744, 64);
    }

    __aicore__ inline void Process()
    {
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        DataCopyPad(x_, xgm_, copy, pad);
        DataCopyPad(r_, rgm_, copy, pad);
        DataCopyPad(g_, ggm_, copy, pad);
        DataCopyPad(b_, bgm_, copy, pad);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        if (sizeof(T) == sizeof(float) && d_ == padded_) {
            y_ = x_.template ReinterpretCast<float>();
            tmp_ = r_.template ReinterpretCast<float>();
        } else {
            if (d_ != padded_) {
                Duplicate(y_[d_ / 64 * 64], 0.0f, 64);
                PipeBarrier<PIPE_V>();
            }
            ToFloat<T>(y_, x_, d_);
            ToFloat<T>(tmp_, r_, d_);
        }
        if (sizeof(T) == sizeof(float)) {
            gf_ = g_.template ReinterpretCast<float>();
            bf_ = b_.template ReinterpretCast<float>();
        } else {
            ToFloat<T>(gf_, g_, d_);
            ToFloat<T>(bf_, b_, d_);
        }
        PipeBarrier<PIPE_V>();
        Add(y_, y_, tmp_, d_);
        PipeBarrier<PIPE_V>();
        Mul(tmp_, y_, y_, padded_);
        PipeBarrier<PIPE_V>();
        const uint32_t parts = padded_ / 64;
        // A2 ReduceSum(count) is not supported in static Tensor mode. Two
        // hardware reductions retain FP32 arithmetic while tree-summing the
        // repeat partials. This differs from the baseline's sequential final
        // accumulation, and must be checked against the official tolerance.
        WholeReduceSum(partials_, tmp_, 64, parts, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(sum_, partials_, static_cast<int32_t>(parts), 1, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Muls(sum_, sum_, invD_, 1);
        PipeBarrier<PIPE_V>();
        Adds(sum_, sum_, epsilon_, 1);
        PipeBarrier<PIPE_V>();
        Sqrt(sum_, sum_, 1);
        PipeBarrier<PIPE_V>();
        Brcb(work_, sum_, 1, {1, 8});
        PipeBarrier<PIPE_V>();
        Div(y_, y_, work_, static_cast<uint64_t>(64), static_cast<uint8_t>(parts),
            {1, 1, 0, 8, 8, 0});
        PipeBarrier<PIPE_V>();
        // Preserve combo_core's affine FMA and normalization placement.
        FusedMulAdd(y_, gf_, bf_, d_);
        PipeBarrier<PIPE_V>();
        if (sizeof(T) == sizeof(float)) {
            // VECIN (aligned) and VECOUT (unaligned) are both A2 DMA sources.
            // Retain the baseline's final FP32 Adds(+0) conversion.
            Adds(y_, y_, 0.0f, d_);
            PipeBarrier<PIPE_V>();
            result_ = y_.template ReinterpretCast<T>();
        } else {
            FromFloat<T>(result_, y_, d_);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(1);
        WaitFlag<HardEvent::V_MTE3>(1);
        DataCopyPad(outgm_, result_, copy);
        SetFlag<HardEvent::MTE3_V>(2);
        WaitFlag<HardEvent::MTE3_V>(2);
    }

private:
    GlobalTensor<T> xgm_, rgm_, ggm_, bgm_, outgm_;
    LocalTensor<T> x_, r_, g_, b_, result_;
    LocalTensor<float> y_, tmp_, gf_, bf_, partials_, sum_, work_;
    uint32_t d_, padded_;
    float invD_, epsilon_;
};

template <typename T>
__global__ __vector__ void single_row_static_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t d, float inverseD, float epsilon)
{
    InitSocState();
    SingleRowStaticKernel<T> op;
    op.Init(x, residual, gamma, bias, output, d, inverseD, epsilon);
    op.Process();
}

// A small number of rows per core uses static UB and cached parameters.
// This entry is selected only when the host's grouped batch path is inactive.
template <typename T, bool AlignedDma = false>
class SmallRowsStaticKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint64_t rows, uint32_t d, float inverseD, float epsilon)
    {
        rows_ = rows;
        d_ = d;
        padded_ = (d + 63) / 64 * 64;
        invD_ = inverseD;
        epsilon_ = epsilon;
        xgm_.SetGlobalBuffer((__gm__ T*)x);
        rgm_.SetGlobalBuffer((__gm__ T*)r);
        ggm_.SetGlobalBuffer((__gm__ T*)g);
        bgm_.SetGlobalBuffer((__gm__ T*)b);
        outgm_.SetGlobalBuffer((__gm__ T*)out);
        // Each fixed slot reserves 16384 B, enough for 4096 FP32 elements.
        // Slots are byte-addressed, 32 B aligned, and never exceed UB148000 B.
        x_ = LocalTensor<T>(TPosition::VECIN, 0, padded_);
        r_ = LocalTensor<T>(TPosition::VECIN, 16384, padded_);
        g_ = LocalTensor<T>(TPosition::VECIN, 32768, padded_);
        b_ = LocalTensor<T>(TPosition::VECIN, 49152, padded_);
        y_ = LocalTensor<float>(TPosition::VECOUT, 65536, padded_);
        tmp_ = LocalTensor<float>(TPosition::VECCALC, 81920, padded_);
        gf_ = LocalTensor<float>(TPosition::VECCALC, 98304, padded_);
        bf_ = LocalTensor<float>(TPosition::VECCALC, 114688, padded_);
        result_ = LocalTensor<T>(TPosition::VECOUT, 131072, padded_);
        partials_ = LocalTensor<float>(TPosition::VECCALC, 147456, 64);
        sum_ = LocalTensor<float>(TPosition::VECCALC, 147712, 8);
        work_ = LocalTensor<float>(TPosition::VECCALC, 147744, 64);
    }

    __aicore__ inline void Process()
    {
        CacheParameters();
        for (uint64_t row = GetBlockIdx(); row < rows_; row += GetBlockNum()) {
            ProcessRow(row);
        }
    }

    __aicore__ inline void CacheParameters()
    {
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        if (AlignedDma) {
            // Host enables this variant only for FP32 and D divisible by 64.
            // DataCopyParams.blockLen is in 32 B blocks, not bytes.
            DataCopyParams aligned = {1, static_cast<uint16_t>(d_ * sizeof(T) / 32), 0, 0};
            DataCopy(g_, ggm_, aligned);
            DataCopy(b_, bgm_, aligned);
        } else {
            DataCopyPad(g_, ggm_, copy, pad);
            DataCopyPad(b_, bgm_, copy, pad);
        }
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        if (sizeof(T) == sizeof(float)) {
            gf_ = g_.template ReinterpretCast<float>();
            bf_ = b_.template ReinterpretCast<float>();
        } else {
            ToFloat<T>(gf_, g_, d_);
            ToFloat<T>(bf_, b_, d_);
        }
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ProcessRow(uint64_t row)
    {
        const uint64_t base = row * d_;
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        if (AlignedDma) {
            DataCopyParams aligned = {1, static_cast<uint16_t>(d_ * sizeof(T) / 32), 0, 0};
            DataCopy(x_, xgm_[base], aligned);
            DataCopy(r_, rgm_[base], aligned);
        } else {
            DataCopyPad(x_, xgm_[base], copy, pad);
            DataCopyPad(r_, rgm_[base], copy, pad);
        }
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        if (sizeof(T) == sizeof(float) && d_ == padded_) {
            y_ = x_.template ReinterpretCast<float>();
            tmp_ = r_.template ReinterpretCast<float>();
        } else {
            if (d_ != padded_) {
                Duplicate(y_[d_ / 64 * 64], 0.0f, 64);
                PipeBarrier<PIPE_V>();
            }
            ToFloat<T>(y_, x_, d_);
            ToFloat<T>(tmp_, r_, d_);
        }
        PipeBarrier<PIPE_V>();
        Add(y_, y_, tmp_, d_);
        PipeBarrier<PIPE_V>();
        Mul(tmp_, y_, y_, padded_);
        PipeBarrier<PIPE_V>();
        const uint32_t parts = padded_ / 64;
        // A2 ReduceSum(count) is not supported in static Tensor mode. Two
        // hardware reductions retain FP32 arithmetic while tree-summing the
        // repeat partials. This differs from the baseline's sequential final
        // accumulation, and must be checked against the official tolerance.
        if (parts == 1) {
            WholeReduceSum(sum_, tmp_, 64, 1, 1, 1, 8);
        } else {
            WholeReduceSum(partials_, tmp_, 64, parts, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(sum_, partials_, static_cast<int32_t>(parts), 1, 1, 1, 8);
        }
        PipeBarrier<PIPE_V>();
        Muls(sum_, sum_, invD_, 1);
        PipeBarrier<PIPE_V>();
        Adds(sum_, sum_, epsilon_, 1);
        PipeBarrier<PIPE_V>();
        Sqrt(sum_, sum_, 1);
        PipeBarrier<PIPE_V>();
        Brcb(work_, sum_, 1, {1, 8});
        PipeBarrier<PIPE_V>();
        Div(y_, y_, work_, static_cast<uint64_t>(64), static_cast<uint8_t>(parts),
            {1, 1, 0, 8, 8, 0});
        PipeBarrier<PIPE_V>();
        // Preserve combo_core's affine FMA and normalization placement.
        FusedMulAdd(y_, gf_, bf_, d_);
        PipeBarrier<PIPE_V>();
        if (sizeof(T) == sizeof(float)) {
            // VECIN (aligned) and VECOUT (unaligned) are both A2 DMA sources.
            // Retain the baseline's final FP32 Adds(+0) conversion.
            Adds(y_, y_, 0.0f, d_);
            PipeBarrier<PIPE_V>();
            result_ = y_.template ReinterpretCast<T>();
        } else {
            FromFloat<T>(result_, y_, d_);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(1);
        WaitFlag<HardEvent::V_MTE3>(1);
        if (AlignedDma) {
            DataCopyParams aligned = {1, static_cast<uint16_t>(d_ * sizeof(T) / 32), 0, 0};
            DataCopy(outgm_[base], result_, aligned);
        } else {
            DataCopyPad(outgm_[base], result_, copy);
        }
        // V and MTE2 are separate pipelines. Guard both future vector writes
        // and future input DMA writes against the preceding GM output read.
        SetFlag<HardEvent::MTE3_V>(2);
        WaitFlag<HardEvent::MTE3_V>(2);
        SetFlag<HardEvent::MTE3_MTE2>(3);
        WaitFlag<HardEvent::MTE3_MTE2>(3);
    }

private:
    GlobalTensor<T> xgm_, rgm_, ggm_, bgm_, outgm_;
    LocalTensor<T> x_, r_, g_, b_, result_;
    LocalTensor<float> y_, tmp_, gf_, bf_, partials_, sum_, work_;
    uint64_t rows_;
    uint32_t d_, padded_;
    float invD_, epsilon_;
};

template <typename T, bool AlignedDma = false>
__global__ __vector__ void small_rows_static_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t d, float inverseD, float epsilon)
{
    InitSocState();
    SmallRowsStaticKernel<T, AlignedDma> op;
    op.Init(x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
    op.Process();
}

template <typename T, bool AlignedDma = false>
class RawFewFloatKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint64_t rows, uint32_t d, float inverseD, float epsilon)
    {
        static_assert(sizeof(T) == sizeof(float), "FP32 entry only");
        rows_ = rows;
        d_ = d;
        padded_ = (d + 63) / 64 * 64;
        invD_ = inverseD;
        epsilon_ = epsilon;
        xgm_.SetGlobalBuffer((__gm__ T*)x);
        rgm_.SetGlobalBuffer((__gm__ T*)r);
        ggm_.SetGlobalBuffer((__gm__ T*)g);
        bgm_.SetGlobalBuffer((__gm__ T*)b);
        outgm_.SetGlobalBuffer((__gm__ T*)out);
        // Each fixed slot reserves 16384 B, enough for 4096 FP32 elements.
        // 128 B gaps spread operand bank groups; highest byte is 149376.
        x_ = LocalTensor<T>(TPosition::VECIN, 0, padded_);
        r_ = LocalTensor<T>(TPosition::VECIN, 16512, padded_);
        g_ = LocalTensor<T>(TPosition::VECIN, 33024, padded_);
        b_ = LocalTensor<T>(TPosition::VECIN, 49536, padded_);
        y_ = LocalTensor<float>(TPosition::VECOUT, 66048, padded_);
        tmp_ = LocalTensor<float>(TPosition::VECCALC, 82560, padded_);
        gf_ = LocalTensor<float>(TPosition::VECCALC, 99072, padded_);
        bf_ = LocalTensor<float>(TPosition::VECCALC, 115584, padded_);
        result_ = LocalTensor<T>(TPosition::VECOUT, 132096, padded_);
        partials_ = LocalTensor<float>(TPosition::VECCALC, 148608, 64);
        sum_ = LocalTensor<float>(TPosition::VECCALC, 148992, 8);
        work_ = LocalTensor<float>(TPosition::VECCALC, 149120, 64);
    }

    __aicore__ inline void Process()
    {
        for (uint64_t row = GetBlockIdx(); row < rows_; row += GetBlockNum()) {
            ProcessRow(row);
        }
    }

    __aicore__ inline void CacheParameters()
    {
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        if (AlignedDma) {
            // Host enables this variant only for FP32 and D divisible by 64.
            // DataCopyParams.blockLen is in 32 B blocks, not bytes.
            DataCopyParams aligned = {1, static_cast<uint16_t>(d_ * sizeof(T) / 32), 0, 0};
            DataCopy(g_, ggm_, aligned);
            DataCopy(b_, bgm_, aligned);
        } else {
            DataCopyPad(g_, ggm_, copy, pad);
            DataCopyPad(b_, bgm_, copy, pad);
        }
        // The first input DMA already precedes this parameter DMA.
        // Wait for these parameters only when the affine stage needs them.
        SetFlag<HardEvent::MTE2_V>(1);
        gf_ = g_.template ReinterpretCast<float>();
        bf_ = b_.template ReinterpretCast<float>();
    }

    __aicore__ inline void ProcessRow(uint64_t row)
    {
        const uint64_t base = row * d_;
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        if (AlignedDma) {
            DataCopyParams aligned = {1, static_cast<uint16_t>(d_ * sizeof(T) / 32), 0, 0};
            DataCopy(x_, xgm_[base], aligned);
            DataCopy(r_, rgm_[base], aligned);
        } else {
            DataCopyPad(x_, xgm_[base], copy, pad);
            DataCopyPad(r_, rgm_[base], copy, pad);
        }
        SetFlag<HardEvent::MTE2_V>(0);
        const bool first = row == GetBlockIdx();
        if (first) CacheParameters();
        WaitFlag<HardEvent::MTE2_V>(0);
        // Both inputs are FP32, including the non-aligned case. There is no
        // input conversion or temporary copy. Only the reduction tail is zero.
        y_ = x_.template ReinterpretCast<float>();
        tmp_ = r_.template ReinterpretCast<float>();
        Add(y_, y_, tmp_, d_);
        PipeBarrier<PIPE_V>();
        if (d_ != padded_) {
            uint64_t tail[2] = {~static_cast<uint64_t>(0) << (d_ % 64), 0};
            Duplicate(y_[d_ / 64 * 64], 0.0f, tail, 1, 1, 8);
            PipeBarrier<PIPE_V>();
        }
        Mul(tmp_, y_, y_, padded_);
        PipeBarrier<PIPE_V>();
        const uint32_t parts = padded_ / 64;
        // A2 ReduceSum(count) is not supported in static Tensor mode. Two
        // hardware reductions retain FP32 arithmetic while tree-summing the
        // repeat partials. This differs from the baseline's sequential final
        // accumulation, and must be checked against the official tolerance.
        if (parts == 1) {
            WholeReduceSum(sum_, tmp_, 64, 1, 1, 1, 8);
        } else {
            WholeReduceSum(partials_, tmp_, 64, parts, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(sum_, partials_, static_cast<int32_t>(parts), 1, 1, 1, 8);
        }
        PipeBarrier<PIPE_V>();
        Muls(sum_, sum_, invD_, 1);
        PipeBarrier<PIPE_V>();
        Adds(sum_, sum_, epsilon_, 1);
        PipeBarrier<PIPE_V>();
        Sqrt(sum_, sum_, 1);
        PipeBarrier<PIPE_V>();
        Brcb(work_, sum_, 1, {1, 8});
        PipeBarrier<PIPE_V>();
        Div(y_, y_, work_, static_cast<uint64_t>(64), static_cast<uint8_t>(parts),
            {1, 1, 0, 8, 8, 0});
        PipeBarrier<PIPE_V>();
        // Preserve combo_core's affine FMA and normalization placement.
        if (first) WaitFlag<HardEvent::MTE2_V>(1);
        FusedMulAdd(y_, gf_, bf_, d_);
        PipeBarrier<PIPE_V>();
        if (sizeof(T) == sizeof(float)) {
            // VECIN (aligned) and VECOUT (unaligned) are both A2 DMA sources.
            // Retain the baseline's final FP32 Adds(+0) conversion.
            Adds(y_, y_, 0.0f, d_);
            PipeBarrier<PIPE_V>();
            result_ = y_.template ReinterpretCast<T>();
        } else {
            FromFloat<T>(result_, y_, d_);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(1);
        WaitFlag<HardEvent::V_MTE3>(1);
        if (AlignedDma) {
            DataCopyParams aligned = {1, static_cast<uint16_t>(d_ * sizeof(T) / 32), 0, 0};
            DataCopy(outgm_[base], result_, aligned);
        } else {
            DataCopyPad(outgm_[base], result_, copy);
        }
        // Output aliases X. The next X DMA waits here, and the next vector
        // operation waits for that DMA, so one dependency guards both uses.
        SetFlag<HardEvent::MTE3_MTE2>(3);
        WaitFlag<HardEvent::MTE3_MTE2>(3);
    }

private:
    GlobalTensor<T> xgm_, rgm_, ggm_, bgm_, outgm_;
    LocalTensor<T> x_, r_, g_, b_, result_;
    LocalTensor<float> y_, tmp_, gf_, bf_, partials_, sum_, work_;
    uint64_t rows_;
    uint32_t d_, padded_;
    float invD_, epsilon_;
};

template <typename T, bool AlignedDma = false>
__global__ __vector__ void raw_few_float_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t d, float inverseD, float epsilon)
{
    InitSocState();
    RawFewFloatKernel<T, AlignedDma> op;
    op.Init(x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
    op.Process();
}

// Many whole rows use manual ping/pong input and output buffers. Only
// basic CANN9 A2 static-Tensor APIs and event IDs 0/1 are used by this entry.
template <typename T>
class WholeRowsStaticDoubleBufferKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint64_t rows, uint32_t d,
                               float inverseD, float epsilon)
    {
        rows_ = rows;
        d_ = d;
        padded_ = (d + 63) / 64 * 64;
        invD_ = inverseD;
        epsilon_ = epsilon;
        xgm_.SetGlobalBuffer((__gm__ T*)x);
        rgm_.SetGlobalBuffer((__gm__ T*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ T*)g);
        bgm_.SetGlobalBuffer((__gm__ T*)b);
        outgm_.SetGlobalBuffer((__gm__ T*)out);
        // Shift 16 KiB reservations in 128 B steps. The affine operand starts
        // are at byte phases 0/256/384 modulo 512 for both ping/pong and lowY.
        // This is a performance hypothesis, not a bank-disjointness guarantee.
        // All starts are 32 B aligned; the declared UB end is 165920 B.
        xPing_ = LocalTensor<T>(TPosition::VECIN, 0, padded_);
        rPing_ = LocalTensor<T>(TPosition::VECIN, 16512, padded_);
        gf_ = LocalTensor<float>(TPosition::VECIN, 33024, padded_);
        bf_ = LocalTensor<float>(TPosition::VECIN, 49536, padded_);
        xPong_ = LocalTensor<T>(TPosition::VECIN, 66048, padded_);
        rPong_ = LocalTensor<T>(TPosition::VECIN, 82560, padded_);
        lowY_ = LocalTensor<float>(TPosition::VECCALC, 99328, padded_);
        lowTmp_ = LocalTensor<float>(TPosition::VECCALC, 115840, padded_);
        outPing_ = LocalTensor<T>(TPosition::VECOUT, 132352, padded_);
        outPong_ = LocalTensor<T>(TPosition::VECOUT, 148864, padded_);
        partials_ = LocalTensor<float>(TPosition::VECCALC, 165376, 64);
        sum_ = LocalTensor<float>(TPosition::VECCALC, 165632, 8);
        work_ = LocalTensor<float>(TPosition::VECCALC, 165664, 64);
    }

    __aicore__ inline void Process()
    {
        CacheParameters();
        // Parameter casts finish before low-type ping slots are reused.
        SetFlag<HardEvent::V_MTE2>(0);
        SetFlag<HardEvent::V_MTE2>(1);
        SetFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::MTE3_V>(1);
        if (sizeof(T) == sizeof(float)) {
            SetFlag<HardEvent::MTE3_MTE2>(0);
            SetFlag<HardEvent::MTE3_MTE2>(1);
        }
        // The host guard guarantees at least four rows on every core.
        const uint64_t core = GetBlockIdx();
        const uint64_t cores = GetBlockNum();
        const uint64_t begin = rows_ * core / cores;
        const uint64_t end = rows_ * (core + 1) / cores;
        PrefetchRow(begin, 0);
        PrefetchRow(begin + 1, 1);
        uint32_t slot = 0;
        for (uint64_t row = begin; row < end; ++row, slot ^= 1) {
            ProcessRow(row, slot, end);
        }
        // Drain the final free-buffer events. Each slot was used at least
        // twice, and the last iteration produced exactly one of every event.
        WaitFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(1);
        WaitFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(1);
        if (sizeof(T) == sizeof(float)) {
            WaitFlag<HardEvent::MTE3_MTE2>(0);
            WaitFlag<HardEvent::MTE3_MTE2>(1);
        }
    }

    __aicore__ inline void CacheParameters()
    {
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        if (sizeof(T) == sizeof(float)) {
            DataCopyPad(gf_.template ReinterpretCast<T>(), ggm_, copy, pad);
            DataCopyPad(bf_.template ReinterpretCast<T>(), bgm_, copy, pad);
        } else {
            DataCopyPad(xPing_, ggm_, copy, pad);
            DataCopyPad(rPing_, bgm_, copy, pad);
        }
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        if (sizeof(T) != sizeof(float)) {
            ToFloat<T>(gf_, xPing_, d_);
            ToFloat<T>(bf_, rPing_, d_);
            PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void PrefetchRow(uint64_t row, uint32_t slot)
    {
        WaitFlag<HardEvent::V_MTE2>(slot);
        if (sizeof(T) == sizeof(float)) {
            // D2 retains the original MTE3->MTE2 fence accounting. The signal
            // precedes current independent-output DMA; V_MTE2 guards raw inputs.
            WaitFlag<HardEvent::MTE3_MTE2>(slot);
        }
        LocalTensor<T>& x = slot == 0 ? xPing_ : xPong_;
        LocalTensor<T>& r = slot == 0 ? rPing_ : rPong_;
        const uint64_t base = row * d_;
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        DataCopyPad(x, xgm_[base], copy, pad);
        DataCopyPad(r, rgm_[base], copy, pad);
        // One event joins both independent input DMA copies.
        SetFlag<HardEvent::MTE2_V>(slot);
    }

    __aicore__ inline void ProcessRow(uint64_t row, uint32_t slot, uint64_t rowEnd)
    {
        WaitFlag<HardEvent::MTE2_V>(slot);
        LocalTensor<T>& x = slot == 0 ? xPing_ : xPong_;
        LocalTensor<T>& r = slot == 0 ? rPing_ : rPong_;
        LocalTensor<T>& out = slot == 0 ? outPing_ : outPong_;
        LocalTensor<float> y = lowY_;
        LocalTensor<float> tmp = lowTmp_;
        const uint64_t next = row + 2;
        if (sizeof(T) == sizeof(float)) {
            WaitFlag<HardEvent::MTE3_V>(slot);
            y = x.template ReinterpretCast<float>();
            tmp = r.template ReinterpretCast<float>();
            Add(y, y, tmp, d_);
            PipeBarrier<PIPE_V>();
            if (d_ != padded_) {
                // Clear only invalid lanes. Clearing a full last segment
                // would overwrite valid x lanes because FP32 y aliases x.
                uint64_t tailMask[2] = {~static_cast<uint64_t>(0) << (d_ % 64), 0};
                Duplicate(y[d_ / 64 * 64], 0.0f, tailMask, 1, 1, 8);
                PipeBarrier<PIPE_V>();
            }
        } else {
            if (d_ != padded_) {
                Duplicate(y[d_ / 64 * 64], 0.0f, 64);
                PipeBarrier<PIPE_V>();
            }
            ToFloat<T>(y, x, d_);
            ToFloat<T>(tmp, r, d_);
            PipeBarrier<PIPE_V>();
            // FP16 input reads end at the preceding Cast barrier. The Add
            // reads disjoint lowY/lowTmp, so its work can overlap next DMA.
            const bool earlyInputRelease = CompactParameterType<T>::value &&
                                           d_ >= 513 && d_ <= 1023;
            if (earlyInputRelease) {
                SetFlag<HardEvent::V_MTE2>(slot);
                if (next < rowEnd) PrefetchRow(next, slot);
            }
            Add(y, y, tmp, d_);
            PipeBarrier<PIPE_V>();
            if (!earlyInputRelease) {
                SetFlag<HardEvent::V_MTE2>(slot);
                if (next < rowEnd) PrefetchRow(next, slot);
            }
        }
        Mul(tmp, y, y, padded_);
        PipeBarrier<PIPE_V>();
        const uint32_t parts = padded_ / 64;
        WholeReduceSum(partials_, tmp, 64, parts, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(sum_, partials_, static_cast<int32_t>(parts), 1, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Muls(sum_, sum_, invD_, 1);
        PipeBarrier<PIPE_V>();
        Adds(sum_, sum_, epsilon_, 1);
        PipeBarrier<PIPE_V>();
        Sqrt(sum_, sum_, 1);
        PipeBarrier<PIPE_V>();
        Brcb(work_, sum_, 1, {1, 8});
        PipeBarrier<PIPE_V>();
        Div(y, y, work_, static_cast<uint64_t>(64), static_cast<uint8_t>(parts),
            {1, 1, 0, 8, 8, 0});
        PipeBarrier<PIPE_V>();
        FusedMulAdd(y, gf_, bf_, d_);
        PipeBarrier<PIPE_V>();
        if (sizeof(T) == sizeof(float)) {
            // D2 uses the already-reserved output slot; arithmetic still Adds(+0).
            // The begin-of-row MTE3_V wait protects this slot from its prior DMA.
            auto outputFloat = out.template ReinterpretCast<float>();
            Adds(outputFloat, y, 0.0f, d_);
            PipeBarrier<PIPE_V>();
            // Raw x/y and r/tmp have no readers after the final Adds to output.
            SetFlag<HardEvent::V_MTE2>(slot);
            // Keep the fence count, but current output DMA no longer reads x.
            SetFlag<HardEvent::MTE3_MTE2>(slot);
            if (next < rowEnd) PrefetchRow(next, slot);
        } else {
            WaitFlag<HardEvent::MTE3_V>(slot);
            FromFloat<T>(out, y, d_);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(slot);
        WaitFlag<HardEvent::V_MTE3>(slot);
        const uint64_t base = row * d_;
        DataCopyExtParams copy = {1, static_cast<uint32_t>(d_ * sizeof(T)), 0, 0, 0};
        DataCopyPad(outgm_[base], out, copy);
        SetFlag<HardEvent::MTE3_V>(slot);
    }

private:
    GlobalTensor<T> xgm_, rgm_, ggm_, bgm_, outgm_;
    LocalTensor<T> xPing_, rPing_, xPong_, rPong_, outPing_, outPong_;
    LocalTensor<float> gf_, bf_, lowY_, lowTmp_, partials_, sum_, work_;
    uint64_t rows_;
    uint32_t d_, padded_;
    float invD_, epsilon_;
};

template <typename T>
__global__ __vector__ void whole_rows_static_db_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t d, float inverseD, float epsilon)
{
    InitSocState();
    WholeRowsStaticDoubleBufferKernel<T> op;
    op.Init(x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
    op.Process();
}

// Long rows keep their FP32 residual sum in UB. The same two input queues
// carry x/residual in phase one and gamma/bias in phase two.
// E017 L1: raw FP16 x/r are no longer read after conversion completes.
// FP32/BF16 keep the parent lifetime and scheduling.
template <typename T> struct RetainedEarlyInputPrefetchType { static constexpr bool value = false; };
template <> struct RetainedEarlyInputPrefetchType<half> { static constexpr bool value = true; };

template <typename T>
class RetainedLongRowKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint64_t rows, uint32_t d,
                               uint32_t tile, float inverseD, float epsilon)
    {
        rows_ = rows;
        d_ = d;
        tile_ = tile;
        invD_ = inverseD;
        epsilon_ = epsilon;
        x_.SetGlobalBuffer((__gm__ T*)x);
        r_.SetGlobalBuffer((__gm__ T*)r);ConfigureLargeInputCache(x_,r_,rows,d);
        g_.SetGlobalBuffer((__gm__ T*)g);
        b_.SetGlobalBuffer((__gm__ T*)b);
        out_.SetGlobalBuffer((__gm__ T*)out);
        // FP32 writes directly from the retained y buffer, so larger tiles
        // fit with one raw input buffer. Low dtypes retain the cast-out queue.
        const uint8_t inputBuffers = sizeof(T) == sizeof(float) ? 1 : 2;
        pipe_.InitBuffer(qfirst_, inputBuffers, tile * sizeof(T));
        pipe_.InitBuffer(qsecond_, inputBuffers, tile * sizeof(T));
        if (sizeof(T) != sizeof(float)) {
            pipe_.InitBuffer(qout_, 1, tile * sizeof(T));
        }
        pipe_.InitBuffer(ybuf_, ((d + 63) / 64 * 64) * sizeof(float));
        pipe_.InitBuffer(tmpbuf_, tile * sizeof(float));
        const uint32_t reductionBytes = tile / 64 * 32;
        pipe_.InitBuffer(workbuf_, reductionBytes < 1024 ? 1024 : reductionBytes);
        // Maximum 16 chunks (FP32), each partial occupies one aligned block.
        // A 1024-byte allocation also permits zero-filled eight-part groups.
        pipe_.InitBuffer(partials_, 1024);
    }

    __aicore__ inline void Process()
    {
        const uint32_t chunks = (d_ + tile_ - 1) / tile_;
        const uint32_t groups = (chunks + 7) / 8;
        auto partials = partials_.template Get<float>();
        for (uint64_t row = GetBlockIdx(); row < rows_; row += GetBlockNum()) {
            const uint64_t base = row * d_;
            Duplicate(partials, 0.0f, groups * 64);
            PipeBarrier<PIPE_V>();
            PrefetchPair(x_, r_, base, Min(tile_, d_));
            for (uint32_t col = 0; col < d_; col += tile_) {
                const uint32_t n = Min(tile_, d_ - col);
                ConsumeResidualSum(base, col, n);
                const uint32_t next = col + tile_;
                if (!RetainedEarlyInputPrefetchType<T>::value && next < d_) {
                    PrefetchPair(x_, r_, base + next, Min(tile_, d_ - next));
                }
                StoreSquareSum(col, n, col / tile_);
            }
            const float invRms = ComputeInvRms(groups);
            PrefetchPair(g_, b_, 0, Min(tile_, d_));
            for (uint32_t col = 0; col < d_; col += tile_) {
                const uint32_t n = Min(tile_, d_ - col);
                auto g = qfirst_.template DeQue<T>();
                auto b = qsecond_.template DeQue<T>();
                NormalizeRetained(col, n, invRms, g, b);
                qfirst_.FreeTensor(g);
                qsecond_.FreeTensor(b);
                const uint32_t next = col + tile_;
                if (next < d_) {
                    PrefetchPair(g_, b_, next, Min(tile_, d_ - next));
                }
                StoreOutput(base + col, col, n);
            }
            if (sizeof(T) == sizeof(float)) {
                // Every current-row slice must finish its GM write before the
                // following row overwrites any part of retained y.
                const TEventID done = pipe_.FetchEventID(HardEvent::MTE3_V);
                SetFlag<HardEvent::MTE3_V>(done);
                WaitFlag<HardEvent::MTE3_V>(done);
            }
        }
    }

private:
    __aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }

    __aicore__ inline void CopyIn(LocalTensor<T> dst, GlobalTensor<T> src,
                                 uint64_t offset, uint32_t n)
    {
        DataCopyExtParams p = {1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad = {};
        pad.isPad = false;
        DataCopyPad(dst, src[offset], p, pad);
    }

    __aicore__ inline void PrefetchPair(GlobalTensor<T> first, GlobalTensor<T> second,
                                       uint64_t offset, uint32_t n)
    {
        auto a = qfirst_.template AllocTensor<T>();
        auto b = qsecond_.template AllocTensor<T>();
        CopyIn(a, first, offset, n);
        CopyIn(b, second, offset, n);
        qfirst_.EnQue(a);
        qsecond_.EnQue(b);
    }

    __aicore__ inline void ConsumeResidualSum(uint64_t base, uint32_t col, uint32_t n)
    {
        auto x = qfirst_.template DeQue<T>();
        auto r = qsecond_.template DeQue<T>();
        auto y = ybuf_.template Get<float>()[col];
        auto tmp = tmpbuf_.template Get<float>();
        if (n % 64 != 0) {
            Duplicate(y[n / 64 * 64], 0.0f, 64);
            PipeBarrier<PIPE_V>();
        }
        ToFloat<T>(y, x, n);
        ToFloat<T>(tmp, r, n);
        PipeBarrier<PIPE_V>();
        if (RetainedEarlyInputPrefetchType<T>::value) {
            // Cast is the last reader of both raw input slots. Queue recycling
            // retains its V->MTE2 dependency; Add reads only independent FP32 buffers.
            qfirst_.FreeTensor(x);
            qsecond_.FreeTensor(r);
            const uint32_t next = col + tile_;
            if (next < d_) {
                PrefetchPair(x_, r_, base + next, Min(tile_, d_ - next));
            }
        }
        Add(y, y, tmp, n);
        PipeBarrier<PIPE_V>();
        if (!RetainedEarlyInputPrefetchType<T>::value) {
            qfirst_.FreeTensor(x);
            qsecond_.FreeTensor(r);
        }
    }

    __aicore__ inline void StoreSquareSum(uint32_t col, uint32_t n, uint32_t chunk)
    {
        auto y = ybuf_.template Get<float>()[col];
        auto tmp = tmpbuf_.template Get<float>();
        auto partials = partials_.template Get<float>();
        auto work = workbuf_.template Get<float>();
        const uint32_t padded = (n + 63) / 64 * 64;
        Mul(tmp, y, y, padded);
        PipeBarrier<PIPE_V>();
        ReduceSum(partials[chunk * 8], tmp, work, padded);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline float ComputeInvRms(uint32_t groups)
    {
        auto partials = partials_.template Get<float>();
        auto work = workbuf_.template Get<float>();
        // Each group comprises eight float partials in eight 32-byte blocks.
        uint64_t mask[2] = {0x0101010101010101ULL, 0};
        WholeReduceSum(work, partials, mask, groups, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(partials, work, static_cast<int32_t>(groups), 1, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Muls(partials, partials, invD_, 1);
        PipeBarrier<PIPE_V>();
        Adds(partials, partials, epsilon_, 1);
        PipeBarrier<PIPE_V>();
        Sqrt(partials, partials, 1);
        const TEventID readEv = pipe_.FetchEventID(HardEvent::V_S);
        SetFlag<HardEvent::V_S>(readEv);
        WaitFlag<HardEvent::V_S>(readEv);
        return 1.0f / partials.GetValue(0);
    }

    __aicore__ inline void NormalizeRetained(uint32_t col, uint32_t n, float invRms,
                                            LocalTensor<T> g, LocalTensor<T> b)
    {
        auto y = ybuf_.template Get<float>()[col];
        auto tmp = tmpbuf_.template Get<float>();
        Muls(y, y, invRms, n);
        ToFloat<T>(tmp, g, n);
        PipeBarrier<PIPE_V>();
        Mul(y, y, tmp, n);
        PipeBarrier<PIPE_V>();
        ToFloat<T>(tmp, b, n);
        PipeBarrier<PIPE_V>();
        Add(y, y, tmp, n);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void StoreOutput(uint64_t offset, uint32_t col, uint32_t n)
    {
        auto y = ybuf_.template Get<float>()[col];
        DataCopyExtParams p = {1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
        if (sizeof(T) == sizeof(float)) {
            // Match the baseline FP32 final conversion (Adds with zero).
            Adds(y, y, 0.0f, n);
            PipeBarrier<PIPE_V>();
            const TEventID ready = pipe_.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(ready);
            WaitFlag<HardEvent::V_MTE3>(ready);
            DataCopyPad(out_[offset], y.template ReinterpretCast<T>(), p);
        } else {
            auto out = qout_.template AllocTensor<T>();
            FromFloat<T>(out, y, n);
            PipeBarrier<PIPE_V>();
            qout_.EnQue(out);
            out = qout_.template DeQue<T>();
            DataCopyPad(out_[offset], out, p);
            qout_.FreeTensor(out);
        }
    }

    TPipe pipe_;
    TQue<QuePosition::VECIN, 1> qfirst_, qsecond_;
    TQue<QuePosition::VECOUT, 1> qout_;
    TBuf<QuePosition::VECOUT> ybuf_;
    TBuf<QuePosition::VECCALC> tmpbuf_, workbuf_, partials_;
    GlobalTensor<T> x_, r_, g_, b_, out_;
    uint64_t rows_;
    uint32_t d_, tile_;
    float invD_, epsilon_;
};

template <typename T>
__global__ __vector__ void retained_long_row_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t d, uint32_t tile, float inverseD, float epsilon)
{
    RetainedLongRowKernel<T> op;
    op.Init(x, residual, gamma, bias, output, rows, d, tile, inverseD, epsilon);
    op.Process();
}


// Multi-row RMSNorm: amortize vector setup and DMA over a tile of rows.
// Implemented for CANN9 A2; mathematical accumulation remains FP32.
template <typename T>
class MultiRowWideKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR o, uint64_t rows, uint32_t d, uint32_t capacity, float invD, float eps)
    {
        rows_=rows; d_=d; stride_=(d+63)/64*64; capacity_=capacity;
        batch_=capacity/stride_; invD_=invD; eps_=eps;
        x_.SetGlobalBuffer((__gm__ T*)x); r_.SetGlobalBuffer((__gm__ T*)r);ConfigureLargeInputCache(x_,r_,rows,d);
        g_.SetGlobalBuffer((__gm__ T*)g); b_.SetGlobalBuffer((__gm__ T*)b);
        out_.SetGlobalBuffer((__gm__ T*)o);
        pipe_.InitBuffer(qx_,1,capacity*sizeof(T));
        pipe_.InitBuffer(qr_,1,capacity*sizeof(T));
        pipe_.InitBuffer(qout_,1,capacity*sizeof(T));
        pipe_.InitBuffer(gf_,stride_*sizeof(float));
        pipe_.InitBuffer(bf_,stride_*sizeof(float));
        pipe_.InitBuffer(y_,capacity*sizeof(float));
        pipe_.InitBuffer(tmp_,capacity*sizeof(float));
        // Contiguous reduction partials need capacity/64 floats. The buffer
        // also holds eight-lane inverse-RMS broadcasts, one per batch row.
        pipe_.InitBuffer(work_,capacity/64*32);
        pipe_.InitBuffer(sum_,2*((batch_+7)/8*8)*sizeof(float));
    }
    __aicore__ inline void Process()
    {
        auto gf=gf_.template Get<float>(); auto bf=bf_.template Get<float>();
        auto x=qx_.template AllocTensor<T>();auto r=qr_.template AllocTensor<T>();
        Copy(x,g_,0,1);Copy(r,b_,0,1);qx_.EnQue(x);qr_.EnQue(r);
        x=qx_.template DeQue<T>();r=qr_.template DeQue<T>();
        ToFloat<T>(gf,x,d_);ToFloat<T>(bf,r,d_);PipeBarrier<PIPE_V>();
        qx_.FreeTensor(x);qr_.FreeTensor(r);
        const uint64_t begin=rows_*GetBlockIdx()/GetBlockNum();
        const uint64_t end=rows_*(GetBlockIdx()+1)/GetBlockNum();
        Prefetch(begin,Min(batch_,static_cast<uint32_t>(end-begin)));
        for(uint64_t row=begin;row<end;row+=batch_) {
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end-row));
            const uint32_t active=count*stride_;
            x=qx_.template DeQue<T>();r=qr_.template DeQue<T>();
            auto y=y_.template Get<float>();auto tmp=tmp_.template Get<float>();
            // Convert the flat padded tile with two counter-length casts.
            // Only the reduction's invalid tail lanes need clearing after Add.
            ToFloat<T>(y,x,active);ToFloat<T>(tmp,r,active);
            PipeBarrier<PIPE_V>();
            qx_.FreeTensor(x);qr_.FreeTensor(r);
            // Read buffers can be reused after Cast, while this batch computes
            // entirely from the independent FP32 buffers.
            if(row+batch_<end) Prefetch(row+batch_,Min(batch_,static_cast<uint32_t>(end-row-batch_)));
            Add(y,y,tmp,active);PipeBarrier<PIPE_V>();
            if(d_!=stride_) {
                uint64_t invalid[2]={~static_cast<uint64_t>(0) << (d_%64),0};
                Duplicate(y[d_/64*64],0.0f,invalid,static_cast<uint8_t>(count),
                          1,static_cast<uint8_t>(stride_/8));
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp,y,y,active);PipeBarrier<PIPE_V>();
            auto work=work_.template Get<float>();auto sums=sum_.template Get<float>();
            const uint32_t parts=stride_/64;
            // Pack one sum per 32-byte input block. A whole row of block
            // sums is aligned, so all rows can be reduced with repeated ops.
            const uint32_t rms=(count+7)/8*8;
            Duplicate(sums,1.0f,rms);PipeBarrier<PIPE_V>();
            BlockReduceSum(work,tmp,static_cast<int32_t>(active/64),64,1,1,8);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(sums,work,64,count,1,1,parts);
            WholeReduceSum(sums[rms],work[64],static_cast<int32_t>(stride_/8-64),count,1,1,parts);
            PipeBarrier<PIPE_V>();
            Add(sums,sums,sums[rms],count);PipeBarrier<PIPE_V>();
            Muls(sums,sums,invD_,count);PipeBarrier<PIPE_V>();
            Adds(sums,sums,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums,sums,count);Duplicate(work,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums,work,sums,count);PipeBarrier<PIPE_V>();
            Brcb(work,sums,rms/8,{1,8});PipeBarrier<PIPE_V>();
            if(count>parts) {
                const uint8_t rep=static_cast<uint8_t>(count);
                const uint8_t step=static_cast<uint8_t>(stride_/8);
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y[col],y[col],work,Min(64,d_-col),rep,{1,1,0,step,step,1});
                PipeBarrier<PIPE_V>();
                for(uint32_t col=0;col<d_;col+=64)
                    FusedMulAdd(y[col],gf[col],bf[col],Min(64,d_-col),rep,{1,1,1,step,0,0});
            } else {
                for(uint32_t i=0;i<count;++i)
                    Mul(y[i*stride_],y[i*stride_],work[i*8],64,parts,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                for(uint32_t i=0;i<count;++i)
                    FusedMulAdd(y[i*stride_],gf,bf,d_);
            }
            PipeBarrier<PIPE_V>();
            auto out=qout_.template AllocTensor<T>();FromFloat<T>(out,y,active);PipeBarrier<PIPE_V>();
            qout_.EnQue(out);out=qout_.template DeQue<T>();
            DataCopyExtParams params={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),
                static_cast<uint32_t>((stride_*sizeof(T)-(d_*sizeof(T)+31)/32*32)/32),0,0};
            DataCopyPad(out_[row*d_],out,params);qout_.FreeTensor(out);
        }
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline void Copy(LocalTensor<T> dst,GlobalTensor<T> src,uint64_t offset,uint32_t count) {
        DataCopyExtParams params={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),0,
            static_cast<uint32_t>((stride_*sizeof(T)-(d_*sizeof(T)+31)/32*32)/32),0};
        DataCopyPadExtParams<T> pad={};pad.isPad=false;DataCopyPad(dst,src[offset],params,pad);
    }
    __aicore__ inline void Prefetch(uint64_t row,uint32_t count) {
        auto x=qx_.template AllocTensor<T>();auto r=qr_.template AllocTensor<T>();
        Copy(x,x_,row*d_,count);Copy(r,r_,row*d_,count);qx_.EnQue(x);qr_.EnQue(r);
    }
    TPipe pipe_; TQue<QuePosition::VECIN,1> qx_,qr_;
    TQue<QuePosition::VECOUT,1> qout_;
    TBuf<QuePosition::VECCALC> gf_,bf_,y_,tmp_,work_,sum_;
    GlobalTensor<T> x_,r_,g_,b_,out_;
    uint64_t rows_;uint32_t d_,stride_,capacity_,batch_;float invD_,eps_;
};
template <typename T>
__global__ __vector__ void multi_row_wide_custom(GM_ADDR x,GM_ADDR residual,GM_ADDR gamma,
    GM_ADDR bias,GM_ADDR output,uint64_t rows,uint32_t d,uint32_t capacity,float invD,float eps)
{
    MultiRowWideKernel<T> op;op.Init(x,residual,gamma,bias,output,rows,d,capacity,invD,eps);op.Process();
}

// Multi-row RMSNorm: amortize vector setup and DMA over a tile of rows.
// Implemented for CANN9 A2; mathematical accumulation remains FP32.
template <typename T>
class MultiRowDirectKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR o, uint64_t rows, uint32_t d, uint32_t capacity, float invD, float eps)
    {
        rows_=rows; d_=d; stride_=(d+63)/64*64; capacity_=capacity;
        batch_=capacity/stride_; invD_=invD; eps_=eps;
        x_.SetGlobalBuffer((__gm__ T*)x); r_.SetGlobalBuffer((__gm__ T*)r);ConfigureLargeInputCache(x_,r_,rows,d);
        g_.SetGlobalBuffer((__gm__ T*)g); b_.SetGlobalBuffer((__gm__ T*)b);
        out_.SetGlobalBuffer((__gm__ T*)o);
        pipe_.InitBuffer(qx_,2,capacity*sizeof(T));
        pipe_.InitBuffer(qr_,2,capacity*sizeof(T));
        // Output is written directly from the completed input-x tile.
        pipe_.InitBuffer(gf_,stride_*sizeof(float));
        pipe_.InitBuffer(bf_,stride_*sizeof(float));
        // FP32 arithmetic reuses the dequeued input buffers directly.
        // Contiguous reduction partials need capacity/64 floats. The buffer
        // also holds eight-lane inverse-RMS broadcasts, one per batch row.
        pipe_.InitBuffer(work_,capacity/64*32);
        pipe_.InitBuffer(sum_,((batch_+7)/8*8)*sizeof(float));
    }
    __aicore__ inline void Process()
    {
        auto gf=gf_.template Get<float>(); auto bf=bf_.template Get<float>();
        auto x=qx_.template AllocTensor<T>();auto r=qr_.template AllocTensor<T>();
        Copy(x,g_,0,1);Copy(r,b_,0,1);qx_.EnQue(x);qr_.EnQue(r);
        x=qx_.template DeQue<T>();r=qr_.template DeQue<T>();
        ToFloat<T>(gf,x,d_);ToFloat<T>(bf,r,d_);PipeBarrier<PIPE_V>();
        qx_.FreeTensor(x);qr_.FreeTensor(r);
        const uint64_t begin=rows_*GetBlockIdx()/GetBlockNum();
        const uint64_t end=rows_*(GetBlockIdx()+1)/GetBlockNum();
        Prefetch(begin,Min(batch_,static_cast<uint32_t>(end-begin)));
        if(begin+batch_<end) Prefetch(begin+batch_,Min(batch_,static_cast<uint32_t>(end-begin-batch_)));
        for(uint64_t row=begin;row<end;row+=batch_) {
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end-row));
            const uint32_t active=count*stride_;
            x=qx_.template DeQue<T>();r=qr_.template DeQue<T>();
            auto y=x.template ReinterpretCast<float>();
            auto tmp=r.template ReinterpretCast<float>();
            Add(y,y,tmp,active);PipeBarrier<PIPE_V>();
            if(d_!=stride_) {
                uint64_t tailMask[2]={~static_cast<uint64_t>(0) << (d_%64),0};
                for(uint32_t i=0;i<count;++i)
                    Duplicate(y[i*stride_+d_/64*64],0.0f,tailMask,1,1,8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp,y,y,active);PipeBarrier<PIPE_V>();
            auto work=work_.template Get<float>();auto sums=sum_.template Get<float>();
            const uint32_t parts=stride_/64;
            const uint32_t partialStride=(parts+7)/8*8;
            for(uint32_t i=0;i<count;++i)
                WholeReduceSum(work[i*partialStride],tmp[i*stride_],64,parts,1,1,8);
            PipeBarrier<PIPE_V>();
            // One instruction writes all row sums from an aligned base.
            const uint32_t rms=(count+7)/8*8;
            Duplicate(sums,1.0f,rms);PipeBarrier<PIPE_V>();
            WholeReduceSum(sums,work,static_cast<int32_t>(parts),count,1,1,partialStride/8);
            PipeBarrier<PIPE_V>();
            Muls(sums,sums,invD_,count);PipeBarrier<PIPE_V>();
            Adds(sums,sums,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums,sums,count);Duplicate(work,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums,work,sums,count);PipeBarrier<PIPE_V>();
            Brcb(work,sums,rms/8,{1,8});PipeBarrier<PIPE_V>();
            if(count>parts) {
                const uint8_t rep=static_cast<uint8_t>(count);
                const uint8_t step=static_cast<uint8_t>(stride_/8);
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y[col],y[col],work,Min(64,d_-col),rep,{1,1,0,step,step,1});
                PipeBarrier<PIPE_V>();
                for(uint32_t col=0;col<d_;col+=64)
                    FusedMulAdd(y[col],gf[col],bf[col],Min(64,d_-col),rep,{1,1,1,step,0,0});
            } else {
                for(uint32_t i=0;i<count;++i)
                    Mul(y[i*stride_],y[i*stride_],work[i*8],64,parts,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                for(uint32_t i=0;i<count;++i)
                    FusedMulAdd(y[i*stride_],gf,bf,d_);
            }
            PipeBarrier<PIPE_V>();
            // Direct VECIN -> GM output avoids one whole-tile FP32 copy.
            const TEventID ready=pipe_.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
            DataCopyExtParams params={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),
                static_cast<uint32_t>((stride_*sizeof(T)-(d_*sizeof(T)+31)/32*32)/32),0,0};
            DataCopyPad(out_[row*d_],x,params);
            // x must finish its output DMA before the queue slot can be refilled.
            const TEventID done=pipe_.FetchEventID(HardEvent::MTE3_MTE2);
            SetFlag<HardEvent::MTE3_MTE2>(done);WaitFlag<HardEvent::MTE3_MTE2>(done);
            qx_.FreeTensor(x);qr_.FreeTensor(r);
            if(row+2*batch_<end) Prefetch(row+2*batch_,Min(batch_,static_cast<uint32_t>(end-row-2*batch_)));
        }
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline void Copy(LocalTensor<T> dst,GlobalTensor<T> src,uint64_t offset,uint32_t count) {
        DataCopyExtParams params={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),0,
            static_cast<uint32_t>((stride_*sizeof(T)-(d_*sizeof(T)+31)/32*32)/32),0};
        DataCopyPadExtParams<T> pad={};pad.isPad=false;DataCopyPad(dst,src[offset],params,pad);
    }
    __aicore__ inline void Prefetch(uint64_t row,uint32_t count) {
        auto x=qx_.template AllocTensor<T>();auto r=qr_.template AllocTensor<T>();
        Copy(x,x_,row*d_,count);Copy(r,r_,row*d_,count);qx_.EnQue(x);qr_.EnQue(r);
    }
    TPipe pipe_; TQue<QuePosition::VECIN,2> qx_,qr_;
    TBuf<QuePosition::VECCALC> gf_,bf_,work_,sum_;
    GlobalTensor<T> x_,r_,g_,b_,out_;
    uint64_t rows_;uint32_t d_,stride_,capacity_,batch_;float invD_,eps_;
};
template <typename T>
__global__ __vector__ void multi_row_direct_custom(GM_ADDR x,GM_ADDR residual,GM_ADDR gamma,
    GM_ADDR bias,GM_ADDR output,uint64_t rows,uint32_t d,uint32_t capacity,float invD,float eps)
{
    MultiRowDirectKernel<T> op;op.Init(x,residual,gamma,bias,output,rows,d,capacity,invD,eps);op.Process();
}


// FP16 short rows whose whole per-core partition fits in static UB.
// Two input tiles overlap GM reads with FP32 arithmetic; one output tile
// overlaps the preceding write with the next row batch's reduction.
template <typename T, bool BlockReduction>
class PipelineBatch9Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR out, uint64_t rows, uint32_t d, float invD, float eps)
    {
        d_=d; stride_=(d+63)/64*64; batch_=9408/stride_;
        begin_=rows*GetBlockIdx()/GetBlockNum();
        end_=rows*(GetBlockIdx()+1)/GetBlockNum(); invD_=invD; eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ T*)x); rgm_.SetGlobalBuffer((__gm__ T*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ T*)g); bgm_.SetGlobalBuffer((__gm__ T*)b);
        outgm_.SetGlobalBuffer((__gm__ T*)out);
        x_[0]=LocalTensor<T>(TPosition::VECIN,0,9408);
        x_[1]=LocalTensor<T>(TPosition::VECIN,18944,9408);
        r_[0]=LocalTensor<T>(TPosition::VECIN,37888,9408);
        r_[1]=LocalTensor<T>(TPosition::VECIN,56832,9408);
        y_=LocalTensor<float>(TPosition::VECCALC,75776,9408);
        tmp_=LocalTensor<float>(TPosition::VECCALC,113536,9408);
        out_=LocalTensor<T>(TPosition::VECOUT,151296,9408);
        gamma_=LocalTensor<float>(TPosition::VECCALC,170240,1024);
        bias_=LocalTensor<float>(TPosition::VECCALC,174464,1024);
        gh_=LocalTensor<T>(TPosition::VECIN,178688,1024);
        bh_=LocalTensor<T>(TPosition::VECIN,180864,1024);
        work_=LocalTensor<float>(TPosition::VECCALC,183040,2048);
        sums_=LocalTensor<float>(TPosition::VECCALC,191360,128);
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams parameter={1,static_cast<uint32_t>(d_*sizeof(T)),0,0,0};
        DataCopyPadExtParams<T> pad={}; pad.isPad=false;
        DataCopyPad(gh_,ggm_,parameter,pad); DataCopyPad(bh_,bgm_,parameter,pad);
        SetFlag<HardEvent::MTE2_V>(0); WaitFlag<HardEvent::MTE2_V>(0);
        if(!CompactParameterType<T>::value){ToFloat<T>(gamma_,gh_,d_);ToFloat<T>(bias_,bh_,d_);}
        PipeBarrier<PIPE_V>();
        Prefetch(begin_,0);
        if(begin_+batch_<end_) Prefetch(begin_+batch_,1);
        bool pendingOutput=false;
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
            const uint32_t active=count*stride_;
            WaitFlag<HardEvent::MTE2_V>(slot);
            if(CompactParameterType<T>::value) {
                Add(x_[slot],x_[slot],r_[slot],active);PipeBarrier<PIPE_V>();
                ToFloat<T>(y_,x_[slot],active);PipeBarrier<PIPE_V>();
            } else {
                ToFloat<T>(y_,x_[slot],active);ToFloat<T>(tmp_,r_[slot],active);PipeBarrier<PIPE_V>();
            }
            // This slot is only overwritten after both Cast source reads end.
            if(row+2*batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(slot); WaitFlag<HardEvent::V_MTE2>(slot);
                Prefetch(row+2*batch_,slot);
            }
            if(!CompactParameterType<T>::value){Add(y_,y_,tmp_,active);PipeBarrier<PIPE_V>();}
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                Duplicate(y_[d_/64*64],0.0f,tail,count,1,stride_/8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
            const uint32_t parts=stride_/64;
            if(BlockReduction) {
                BlockReduceSum(work_,tmp_,active/64,64,1,1,8);
                PipeBarrier<PIPE_V>();
                const uint32_t partialRow=parts*8;
                if(partialRow>64) {
                    Add(work_,work_,work_[64],partialRow-64,count,
                        {1,1,1,static_cast<uint8_t>(parts),static_cast<uint8_t>(parts),static_cast<uint8_t>(parts)});
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceSum(sums_,work_,Min(64,partialRow),count,1,1,parts);
            } else if(parts<=8) {
                WholeReduceSum(work_,tmp_,64,active/64,8,1,8);
                PipeBarrier<PIPE_V>();
                uint64_t mask[2]={0,0};
                for(uint32_t p=0;p<parts;++p) mask[0]|=static_cast<uint64_t>(1)<<(p*8);
                WholeReduceSum(sums_,work_,mask,count,1,1,parts);
            } else {
                const uint32_t partialStride=(parts+7)/8*8;
                for(uint32_t i=0;i<count;++i)
                    WholeReduceSum(work_[i*partialStride],tmp_[i*stride_],64,parts,1,1,8);
                PipeBarrier<PIPE_V>();
                WholeReduceSum(sums_,work_,parts,count,1,1,partialStride/8);
            }
            PipeBarrier<PIPE_V>();
            Muls(sums_,sums_,invD_,count); PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count); PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count); Duplicate(work_,1.0f,count); PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count); PipeBarrier<PIPE_V>();
            const uint32_t rms=(count+7)/8*8;
            Brcb(work_,sums_,rms/8,{1,8}); PipeBarrier<PIPE_V>();
            if(count<=parts) {
                for(uint32_t i=0;i<count;++i)
                    Mul(y_[i*stride_],y_[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<T>::value)
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(y_[i*stride_],gamma_,bias_,d_);
            } else {
                const uint8_t step=stride_/8;
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y_[col],y_[col],work_,Min(64,d_-col),count,{1,1,0,step,step,1});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<T>::value)
                    for(uint32_t col=0;col<d_;col+=64)
                        FusedMulAdd(y_[col],gamma_[col],bias_[col],Min(64,d_-col),count,{1,1,1,step,0,0});
            }
            PipeBarrier<PIPE_V>();
            if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
            FromFloat<T>(out_,y_,active); PipeBarrier<PIPE_V>();
            if(CompactParameterType<T>::value) {
                const uint32_t halfParts=(d_+127)/128;
                if(count<=halfParts) {
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(out_[i*stride_].template ReinterpretCast<half>(),gh_.template ReinterpretCast<half>(),bh_.template ReinterpretCast<half>(),d_);
                } else {
                    for(uint32_t col=0;col<d_;col+=128)
                        FusedMulAdd(out_[col].template ReinterpretCast<half>(),gh_[col].template ReinterpretCast<half>(),bh_[col].template ReinterpretCast<half>(),Min(128,d_-col),count,
                            {1,1,1,static_cast<uint8_t>(stride_/16),0,0});
                }
                PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(2); WaitFlag<HardEvent::V_MTE3>(2);
            DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),Gap(),0,0};
            DataCopyPad(outgm_[row*d_],out_,copy);
            SetFlag<HardEvent::MTE3_V>(3); pendingOutput=true;
        }
        if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*sizeof(T)-(static_cast<uint32_t>(d_*sizeof(T))+31)/32*32)/32;}
    __aicore__ inline void Prefetch(uint64_t row,uint32_t slot)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),0,Gap(),0};
        DataCopyPadExtParams<T> pad={}; pad.isPad=false;
        DataCopyPad(x_[slot],xgm_[row*d_],copy,pad);
        DataCopyPad(r_[slot],rgm_[row*d_],copy,pad);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    GlobalTensor<T> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<T> x_[2],r_[2],out_,gh_,bh_;
    LocalTensor<float> y_,tmp_,gamma_,bias_,work_,sums_;
    uint64_t begin_,end_; uint32_t d_,stride_,batch_; float invD_,eps_;
};
template <typename T,bool BlockReduction>
__global__ __vector__ void pipeline_batch9_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState(); PipelineBatch9Kernel<T,BlockReduction> op;
    op.Init(x,r,g,b,out,rows,d,invD,eps); op.Process();
}

class BFloatTripleInplaceKernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
        uint64_t rows,uint32_t d,float invD,float eps)
    {
        d_=d;stride_=(d+63)/64*64;batch_=13312/stride_;
        begin_=rows*GetBlockIdx()/GetBlockNum();end_=rows*(GetBlockIdx()+1)/GetBlockNum();invD_=invD;eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ bfloat16_t*)x);rgm_.SetGlobalBuffer((__gm__ bfloat16_t*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ bfloat16_t*)g);bgm_.SetGlobalBuffer((__gm__ bfloat16_t*)b);outgm_.SetGlobalBuffer((__gm__ bfloat16_t*)out);
        x_[0]=LocalTensor<bfloat16_t>(TPosition::VECIN,0,13312);
        x_[1]=LocalTensor<bfloat16_t>(TPosition::VECIN,26752,13312);
        tmp_=LocalTensor<float>(TPosition::VECCALC,53504,13312);
        r_=tmp_.ReinterpretCast<bfloat16_t>();
        y_=LocalTensor<float>(TPosition::VECCALC,106880,13312);
        gf_=LocalTensor<float>(TPosition::VECCALC,160256,4096);
        bf_=LocalTensor<float>(TPosition::VECCALC,176768,4096);
        work_=LocalTensor<float>(TPosition::VECCALC,193280,320);
        sums_=LocalTensor<float>(TPosition::VECCALC,194688,32);
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams cp={1,d_*2,0,0,0};DataCopyPadExtParams<bfloat16_t> pad={};pad.isPad=false;
        DataCopyPad(x_[0],ggm_,cp,pad);DataCopyPad(r_,bgm_,cp,pad);
        SetFlag<HardEvent::MTE2_V>(3);WaitFlag<HardEvent::MTE2_V>(3);
        Cast(gf_,x_[0],RoundMode::CAST_NONE,d_);Cast(bf_,r_,RoundMode::CAST_NONE,d_);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(3);WaitFlag<HardEvent::V_MTE2>(3);
        Copy(x_[0],xgm_,begin_);SetFlag<HardEvent::MTE2_V>(0);
        Copy(r_,rgm_,begin_);SetFlag<HardEvent::MTE2_V>(2);
        if(begin_+batch_<end_) {Copy(x_[1],xgm_,begin_+batch_);SetFlag<HardEvent::MTE2_V>(1);}
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            WaitFlag<HardEvent::MTE2_V>(slot);WaitFlag<HardEvent::MTE2_V>(2);
            auto y=y_;auto tmp=tmp_;
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row)),active=count*stride_;
            // TMP aliases the raw residual, so read residual before overwriting TMP.
            Cast(y,r_,RoundMode::CAST_NONE,active);PipeBarrier<PIPE_V>();
            Cast(tmp,x_[slot],RoundMode::CAST_NONE,active);PipeBarrier<PIPE_V>();
            Add(y,y,tmp,active);PipeBarrier<PIPE_V>();
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                // A2 high-dimensional repeat strides are only 8 bits.
                // A 3136-float row needs 392 blocks, so clear rows individually.
                for(uint32_t i=0;i<count;++i)Duplicate(y[i*stride_+d_/64*64],0.0f,tail,1,1,8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp,y,y,active);PipeBarrier<PIPE_V>();
            const uint32_t parts=stride_/64,partialStride=(parts+7)/8*8;
            for(uint32_t i=0;i<count;++i)
                WholeReduceSum(work_[i*partialStride],tmp[i*stride_],64,parts,1,1,8);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(sums_,work_,parts,count,1,1,partialStride/8);PipeBarrier<PIPE_V>();
            if(row+batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(2);WaitFlag<HardEvent::V_MTE2>(2);
                Copy(r_,rgm_,row+batch_);SetFlag<HardEvent::MTE2_V>(2);
            }
            Muls(sums_,sums_,invD_,count);PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count);Duplicate(work_,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count);PipeBarrier<PIPE_V>();
            Brcb(work_,sums_,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
            for(uint32_t i=0;i<count;++i)
                Mul(y[i*stride_],y[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
            PipeBarrier<PIPE_V>();
            for(uint32_t i=0;i<count;++i)FusedMulAdd(y[i*stride_],gf_,bf_,d_);
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
            Cast(x_[slot],y,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
            DataCopyExtParams out={static_cast<uint16_t>(count),d_*2,Gap(),0,0};DataCopyPad(outgm_[row*d_],x_[slot],out);
            SetFlag<HardEvent::MTE3_MTE2>(slot);WaitFlag<HardEvent::MTE3_MTE2>(slot);
            if(row+2*batch_<end_) {
                Copy(x_[slot],xgm_,row+2*batch_);SetFlag<HardEvent::MTE2_V>(slot);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*2-(d_*2+31)/32*32)/32;}
    __aicore__ inline void Copy(LocalTensor<bfloat16_t> dst,GlobalTensor<bfloat16_t> src,uint64_t row) {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),d_*2,0,Gap(),0};DataCopyPadExtParams<bfloat16_t> pad={};pad.isPad=false;
        DataCopyPad(dst,src[row*d_],copy,pad);
    }
    GlobalTensor<bfloat16_t> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<bfloat16_t> x_[2],r_;
    LocalTensor<float> y_,tmp_,gf_,bf_,work_,sums_;
    uint64_t begin_,end_;uint32_t d_,stride_,batch_;float invD_,eps_;
};
__global__ __vector__ void bfloat_triple_inplace_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps) {
    InitSocState();BFloatTripleInplaceKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

// D8193..32768: retain the full FP32 residual row, stream directly to it,
// and reuse two residual slots for affine parameters after norm reduction.
class FloatResidentLongKernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
        uint64_t rows,uint32_t d,float invD,float eps) {
        d_=d;stride_=(d+63)/64*64;invD_=invD;eps_=eps;
        begin_=rows*GetBlockIdx()/GetBlockNum();end_=rows*(GetBlockIdx()+1)/GetBlockNum();
        xgm_.SetGlobalBuffer((__gm__ float*)x);rgm_.SetGlobalBuffer((__gm__ float*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ float*)g);bgm_.SetGlobalBuffer((__gm__ float*)b);outgm_.SetGlobalBuffer((__gm__ float*)out);
        y_=LocalTensor<float>(TPosition::VECIN,0,32768);
        r_[0]=LocalTensor<float>(TPosition::VECIN,131200,4096);
        r_[1]=LocalTensor<float>(TPosition::VECIN,147712,4096);
        work_=LocalTensor<float>(TPosition::VECCALC,164224,1024);
        sums_=LocalTensor<float>(TPosition::VECCALC,168448,64);
        rms_=LocalTensor<float>(TPosition::VECCALC,168704,8);
        scale_=LocalTensor<float>(TPosition::VECCALC,168736,64);
    }
    __aicore__ inline void Process() {
        for(uint64_t row=begin_;row<end_;++row) {
            const uint64_t offset=row*d_;
            LoadInput(offset,0,0);
            uint32_t slot=0;
            for(uint32_t col=0;col<d_;col+=4096,slot^=1) {
                const uint32_t n=Min(4096,d_-col),padded=(n+63)/64*64;
                WaitFlag<HardEvent::MTE2_V>(slot);
                if(col+4096<d_)LoadInput(offset,col+4096,slot^1);
                Add(y_[col],y_[col],r_[slot],n);PipeBarrier<PIPE_V>();
                if(n!=padded) {
                    uint64_t mask[2]={~static_cast<uint64_t>(0)<<(n%64),0};
                    Duplicate(y_[col+n/64*64],0.0f,mask,1,1,8);PipeBarrier<PIPE_V>();
                }
                Mul(r_[slot],y_[col],y_[col],padded);PipeBarrier<PIPE_V>();
                WholeReduceSum(work_,r_[slot],64,padded/64,1,1,8);PipeBarrier<PIPE_V>();
                WholeReduceSum(sums_[col/4096*8],work_,padded/64,1,1,1,8);PipeBarrier<PIPE_V>();
                // Both raw-input and square reads are complete before this slot returns.
                SetFlag<HardEvent::V_MTE2>(slot);WaitFlag<HardEvent::V_MTE2>(slot);
            }
            const uint32_t chunks=(d_+4095)/4096;
            uint64_t mask[2]={0,0};for(uint32_t i=0;i<chunks;++i)mask[0]|=static_cast<uint64_t>(1)<<(i*8);
            WholeReduceSum(rms_,sums_,mask,1,1,1,8);PipeBarrier<PIPE_V>();
            LoadParameters(0);
            Muls(rms_,rms_,invD_,1);PipeBarrier<PIPE_V>();
            Adds(rms_,rms_,eps_,1);PipeBarrier<PIPE_V>();
            Sqrt(rms_,rms_,1);Duplicate(scale_,1.0f,8);PipeBarrier<PIPE_V>();
            Div(rms_,scale_,rms_,1);PipeBarrier<PIPE_V>();
            Brcb(scale_,rms_,1,{1,8});PipeBarrier<PIPE_V>();
            for(uint32_t col=0;col<d_;col+=4096) {
                const uint32_t n=Min(4096,d_-col);
                Mul(y_[col],y_[col],scale_,64,(n+63)/64,{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
                WaitFlag<HardEvent::MTE2_V>(0);
                FusedMulAdd(y_[col],r_[0],r_[1],n);PipeBarrier<PIPE_V>();
                if(col+4096<d_) {
                    SetFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(0);
                    LoadParameters(col+4096);
                }
                SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
                DataCopyExtParams p={1,n*4,0,0,0};DataCopyPad(outgm_[offset+col],y_[col],p);
            }
            SetFlag<HardEvent::MTE3_MTE2>(0);WaitFlag<HardEvent::MTE3_MTE2>(0);
        }
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline void Load(LocalTensor<float> dst,GlobalTensor<float> src,uint64_t offset,uint32_t n) {
        DataCopyExtParams p={1,n*4,0,0,0};DataCopyPadExtParams<float> pad={};pad.isPad=false;DataCopyPad(dst,src[offset],p,pad);
    }
    __aicore__ inline void LoadInput(uint64_t offset,uint32_t col,uint32_t slot) {
        const uint32_t n=Min(4096,d_-col);Load(y_[col],xgm_,offset+col,n);Load(r_[slot],rgm_,offset+col,n);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    __aicore__ inline void LoadParameters(uint32_t col) {
        const uint32_t n=Min(4096,d_-col);Load(r_[0],ggm_,col,n);Load(r_[1],bgm_,col,n);
        SetFlag<HardEvent::MTE2_V>(0);
    }
    GlobalTensor<float>xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<float>y_,r_[2],work_,sums_,rms_,scale_;
    uint64_t begin_,end_;uint32_t d_,stride_;float invD_,eps_;
};
__global__ __vector__ void float_resident_long_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps) {
    InitSocState();FloatResidentLongKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class FloatBroadTripleKernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
        uint64_t rows,uint32_t d,float invD,float eps)
    {
        d_=d;stride_=(d+63)/64*64;batch_=12288/stride_;
        begin_=rows*GetBlockIdx()/GetBlockNum();end_=rows*(GetBlockIdx()+1)/GetBlockNum();invD_=invD;eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ float*)x);rgm_.SetGlobalBuffer((__gm__ float*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ float*)g);bgm_.SetGlobalBuffer((__gm__ float*)b);outgm_.SetGlobalBuffer((__gm__ float*)out);
        x_[0]=LocalTensor<float>(TPosition::VECIN,0,12288);
        x_[1]=LocalTensor<float>(TPosition::VECIN,49280,12288);
        r_=LocalTensor<float>(TPosition::VECIN,98560,12288);
        gf_=LocalTensor<float>(TPosition::VECIN,147840,4096);
        bf_=LocalTensor<float>(TPosition::VECIN,164352,4096);
        work_=LocalTensor<float>(TPosition::VECCALC,180864,1536);
        sums_=LocalTensor<float>(TPosition::VECCALC,187136,32);
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams cp={1,d_*4,0,0,0};DataCopyPadExtParams<float> pad={};pad.isPad=false;
        DataCopyPad(gf_,ggm_,cp,pad);DataCopyPad(bf_,bgm_,cp,pad);
        SetFlag<HardEvent::MTE2_V>(3);WaitFlag<HardEvent::MTE2_V>(3);
        Copy(x_[0],xgm_,begin_);SetFlag<HardEvent::MTE2_V>(0);
        Copy(r_,rgm_,begin_);SetFlag<HardEvent::MTE2_V>(2);
        if(begin_+batch_<end_) {Copy(x_[1],xgm_,begin_+batch_);SetFlag<HardEvent::MTE2_V>(1);}
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            WaitFlag<HardEvent::MTE2_V>(slot);WaitFlag<HardEvent::MTE2_V>(2);
            auto y=x_[slot];auto tmp=r_;
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row)),active=count*stride_;
            Add(y,y,tmp,active);PipeBarrier<PIPE_V>();
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                // A2 high-dimensional repeat strides are only 8 bits.
                // A 3136-float row needs 392 blocks, so clear rows individually.
                for(uint32_t i=0;i<count;++i)Duplicate(y[i*stride_+d_/64*64],0.0f,tail,1,1,8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp,y,y,active);PipeBarrier<PIPE_V>();
            const uint32_t parts=stride_/64;
            // Accumulate corresponding lanes across chunks before the final
            // within-vector reduction, as in the installed RMSNorm helper.
            Duplicate(work_,0.0f,count*64);PipeBarrier<PIPE_V>();
            for(uint32_t i=0;i<count;++i)
                Add(work_[i*64],tmp[i*stride_],work_[i*64],64,parts,{1,1,1,0,8,0});
            PipeBarrier<PIPE_V>();
            WholeReduceSum(sums_,work_,64,count,1,1,8);PipeBarrier<PIPE_V>();
            if(row+batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(2);WaitFlag<HardEvent::V_MTE2>(2);
                Copy(r_,rgm_,row+batch_);SetFlag<HardEvent::MTE2_V>(2);
            }
            Muls(sums_,sums_,invD_,count);PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count);Duplicate(work_,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count);PipeBarrier<PIPE_V>();
            Brcb(work_,sums_,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
            for(uint32_t i=0;i<count;++i)
                Mul(y[i*stride_],y[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
            PipeBarrier<PIPE_V>();
            for(uint32_t i=0;i<count;++i)FusedMulAdd(y[i*stride_],gf_,bf_,d_);
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
            DataCopyExtParams out={static_cast<uint16_t>(count),d_*4,Gap(),0,0};DataCopyPad(outgm_[row*d_],y,out);
            SetFlag<HardEvent::MTE3_MTE2>(slot);WaitFlag<HardEvent::MTE3_MTE2>(slot);
            if(row+2*batch_<end_) {
                Copy(x_[slot],xgm_,row+2*batch_);SetFlag<HardEvent::MTE2_V>(slot);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*4-(d_*4+31)/32*32)/32;}
    __aicore__ inline void Copy(LocalTensor<float> dst,GlobalTensor<float> src,uint64_t row) {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),d_*4,0,Gap(),0};DataCopyPadExtParams<float> pad={};pad.isPad=false;
        DataCopyPad(dst,src[row*d_],copy,pad);
    }
    GlobalTensor<float> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<float> x_[2],r_,gf_,bf_,work_,sums_;
    uint64_t begin_,end_;uint32_t d_,stride_,batch_;float invD_,eps_;
};
__global__ __vector__ void float_broad_triple_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState();FloatBroadTripleKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}



template <typename T,bool BlockReduction>
class HalfWidePipelineKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR out, uint64_t rows, uint32_t d, float invD, float eps)
    {
        d_=d; stride_=(d+63)/64*64; batch_=9216/stride_;
        begin_=rows*GetBlockIdx()/GetBlockNum();
        end_=rows*(GetBlockIdx()+1)/GetBlockNum(); invD_=invD; eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ T*)x); rgm_.SetGlobalBuffer((__gm__ T*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ T*)g); bgm_.SetGlobalBuffer((__gm__ T*)b);
        outgm_.SetGlobalBuffer((__gm__ T*)out);
        x_[0]=LocalTensor<T>(TPosition::VECIN,0,9216);
        x_[1]=LocalTensor<T>(TPosition::VECIN,18560,9216);
        r_[0]=LocalTensor<T>(TPosition::VECIN,37120,9216);
        r_[1]=LocalTensor<T>(TPosition::VECIN,55680,9216);
        y_=LocalTensor<float>(TPosition::VECCALC,74240,9216);
        tmp_=LocalTensor<float>(TPosition::VECCALC,111232,9216);
        out_=LocalTensor<T>(TPosition::VECOUT,148224,9216);
        gh_=LocalTensor<T>(TPosition::VECIN,166784,4096);
        bh_=LocalTensor<T>(TPosition::VECIN,175104,4096);
        work_=LocalTensor<float>(TPosition::VECCALC,183424,1152);
        sums_=LocalTensor<float>(TPosition::VECCALC,188160,128);
        // This kernel is instantiated only for half, whose affine uses gh/bh.
        // Float parameter fields are never read in that compile-time branch.
        gamma_=y_;bias_=tmp_;
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams parameter={1,static_cast<uint32_t>(d_*sizeof(T)),0,0,0};
        DataCopyPadExtParams<T> pad={}; pad.isPad=false;
        DataCopyPad(gh_,ggm_,parameter,pad); DataCopyPad(bh_,bgm_,parameter,pad);
        SetFlag<HardEvent::MTE2_V>(0); WaitFlag<HardEvent::MTE2_V>(0);
        if(!CompactParameterType<T>::value){ToFloat<T>(gamma_,gh_,d_);ToFloat<T>(bias_,bh_,d_);}
        PipeBarrier<PIPE_V>();
        Prefetch(begin_,0);
        if(begin_+batch_<end_) Prefetch(begin_+batch_,1);
        bool pendingOutput=false;
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
            const uint32_t active=count*stride_;
            WaitFlag<HardEvent::MTE2_V>(slot);
            if(CompactParameterType<T>::value) {
                Add(x_[slot],x_[slot],r_[slot],active);PipeBarrier<PIPE_V>();
                ToFloat<T>(y_,x_[slot],active);PipeBarrier<PIPE_V>();
            } else {
                ToFloat<T>(y_,x_[slot],active);ToFloat<T>(tmp_,r_[slot],active);PipeBarrier<PIPE_V>();
            }
            // This slot is only overwritten after both Cast source reads end.
            if(row+2*batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(slot); WaitFlag<HardEvent::V_MTE2>(slot);
                Prefetch(row+2*batch_,slot);
            }
            if(!CompactParameterType<T>::value){Add(y_,y_,tmp_,active);PipeBarrier<PIPE_V>();}
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                for(uint32_t i=0;i<count;++i)Duplicate(y_[i*stride_+d_/64*64],0.0f,tail,1,1,8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
            const uint32_t parts=stride_/64;
            if(BlockReduction) {
                BlockReduceSum(work_,tmp_,active/64,64,1,1,8);
                PipeBarrier<PIPE_V>();
                const uint32_t partialRow=parts*8;
                if(partialRow>64) {
                    Add(work_,work_,work_[64],partialRow-64,count,
                        {1,1,1,static_cast<uint8_t>(parts),static_cast<uint8_t>(parts),static_cast<uint8_t>(parts)});
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceSum(sums_,work_,Min(64,partialRow),count,1,1,parts);
            } else if(parts<=8) {
                WholeReduceSum(work_,tmp_,64,active/64,8,1,8);
                PipeBarrier<PIPE_V>();
                uint64_t mask[2]={0,0};
                for(uint32_t p=0;p<parts;++p) mask[0]|=static_cast<uint64_t>(1)<<(p*8);
                WholeReduceSum(sums_,work_,mask,count,1,1,parts);
            } else {
                const uint32_t partialStride=(parts+7)/8*8;
                for(uint32_t i=0;i<count;++i)
                    WholeReduceSum(work_[i*partialStride],tmp_[i*stride_],64,parts,1,1,8);
                PipeBarrier<PIPE_V>();
                WholeReduceSum(sums_,work_,parts,count,1,1,partialStride/8);
            }
            PipeBarrier<PIPE_V>();
            Muls(sums_,sums_,invD_,count); PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count); PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count); Duplicate(work_,1.0f,count); PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count); PipeBarrier<PIPE_V>();
            const uint32_t rms=(count+7)/8*8;
            Brcb(work_,sums_,rms/8,{1,8}); PipeBarrier<PIPE_V>();
            if(count<=parts) {
                for(uint32_t i=0;i<count;++i)
                    Mul(y_[i*stride_],y_[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<T>::value)
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(y_[i*stride_],gamma_,bias_,d_);
            } else {
                const uint8_t step=stride_/8;
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y_[col],y_[col],work_,Min(64,d_-col),count,{1,1,0,step,step,1});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<T>::value)
                    for(uint32_t col=0;col<d_;col+=64)
                        FusedMulAdd(y_[col],gamma_[col],bias_[col],Min(64,d_-col),count,{1,1,1,step,0,0});
            }
            PipeBarrier<PIPE_V>();
            if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
            FromFloat<T>(out_,y_,active); PipeBarrier<PIPE_V>();
            if(CompactParameterType<T>::value) {
                const uint32_t halfParts=(d_+127)/128;
                if(count<=halfParts) {
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(out_[i*stride_].template ReinterpretCast<half>(),gh_.template ReinterpretCast<half>(),bh_.template ReinterpretCast<half>(),d_);
                } else {
                    for(uint32_t col=0;col<d_;col+=128)
                        FusedMulAdd(out_[col].template ReinterpretCast<half>(),gh_[col].template ReinterpretCast<half>(),bh_[col].template ReinterpretCast<half>(),Min(128,d_-col),count,
                            {1,1,1,static_cast<uint8_t>(stride_/16),0,0});
                }
                PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(2); WaitFlag<HardEvent::V_MTE3>(2);
            DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),Gap(),0,0};
            DataCopyPad(outgm_[row*d_],out_,copy);
            SetFlag<HardEvent::MTE3_V>(3); pendingOutput=true;
        }
        if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*sizeof(T)-(static_cast<uint32_t>(d_*sizeof(T))+31)/32*32)/32;}
    __aicore__ inline void Prefetch(uint64_t row,uint32_t slot)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(T)),0,Gap(),0};
        DataCopyPadExtParams<T> pad={}; pad.isPad=false;
        DataCopyPad(x_[slot],xgm_[row*d_],copy,pad);
        DataCopyPad(r_[slot],rgm_[row*d_],copy,pad);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    GlobalTensor<T> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<T> x_[2],r_[2],out_,gh_,bh_;
    LocalTensor<float> y_,tmp_,gamma_,bias_,work_,sums_;
    uint64_t begin_,end_; uint32_t d_,stride_,batch_; float invD_,eps_;
};
template <typename T,bool BlockReduction>
__global__ __vector__ void half_wide_pipeline_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState();HalfWidePipelineKernel<T,BlockReduction> op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class BFloatStatic8Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
        uint64_t rows,uint32_t d,float invD,float eps)
    {
        d_=d;invD_=invD;eps_=eps;parts_=(d+63)/64;
        begin_=rows*GetBlockIdx()/GetBlockNum();end_=rows*(GetBlockIdx()+1)/GetBlockNum();
        xgm_.SetGlobalBuffer((__gm__ bfloat16_t*)x);rgm_.SetGlobalBuffer((__gm__ bfloat16_t*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ bfloat16_t*)g);bgm_.SetGlobalBuffer((__gm__ bfloat16_t*)b);
        outgm_.SetGlobalBuffer((__gm__ bfloat16_t*)out);
        x_=LocalTensor<bfloat16_t>(TPosition::VECIN,0,8192);
        r_=LocalTensor<bfloat16_t>(TPosition::VECIN,16512,8192);
        y_=LocalTensor<float>(TPosition::VECCALC,33024,8192);
        tmp_=LocalTensor<float>(TPosition::VECCALC,65920,8192);
        gf_=LocalTensor<float>(TPosition::VECCALC,98816,8192);
        bf_=LocalTensor<float>(TPosition::VECCALC,131712,8192);
        out_=LocalTensor<bfloat16_t>(TPosition::VECOUT,164608,8192);
        work_=LocalTensor<float>(TPosition::VECCALC,181120,2048);
        sum_=LocalTensor<float>(TPosition::VECCALC,189440,8);
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams cp={1,d_*2,0,0,0};DataCopyPadExtParams<bfloat16_t> pad={};pad.isPad=false;
        DataCopyPad(x_,ggm_,cp,pad);DataCopyPad(r_,bgm_,cp,pad);
        SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
        ToFloat<bfloat16_t>(gf_,x_,d_);ToFloat<bfloat16_t>(bf_,r_,d_);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(0);
        Prefetch(begin_);bool pendingOutput=false;
        for(uint64_t row=begin_;row<end_;++row) {
            WaitFlag<HardEvent::MTE2_V>(0);
            ToFloat<bfloat16_t>(y_,x_,d_);ToFloat<bfloat16_t>(tmp_,r_,d_);PipeBarrier<PIPE_V>();
            if(row+1<end_) {
                SetFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(0);Prefetch(row+1);
            }
            Add(y_,y_,tmp_,d_);PipeBarrier<PIPE_V>();
            if(d_%64) {
                uint64_t mask[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                Duplicate(y_[d_/64*64],0.0f,mask,1,1,8);PipeBarrier<PIPE_V>();
            }
            Mul(tmp_,y_,y_,parts_*64);PipeBarrier<PIPE_V>();
            WholeReduceSum(work_,tmp_,64,parts_,1,1,8);PipeBarrier<PIPE_V>();
            if(parts_>64) {Add(work_,work_,work_[64],parts_-64);PipeBarrier<PIPE_V>();}
            WholeReduceSum(sum_,work_,parts_>64?64:parts_,1,1,1,8);PipeBarrier<PIPE_V>();
            Muls(sum_,sum_,invD_,1);PipeBarrier<PIPE_V>();
            Adds(sum_,sum_,eps_,1);PipeBarrier<PIPE_V>();
            Sqrt(sum_,sum_,1);Duplicate(work_,1.0f,8);PipeBarrier<PIPE_V>();
            Div(sum_,work_,sum_,1);PipeBarrier<PIPE_V>();
            Brcb(work_,sum_,1,{1,8});PipeBarrier<PIPE_V>();
            Mul(y_,y_,work_,64,parts_,{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
            FusedMulAdd(y_,gf_,bf_,d_);PipeBarrier<PIPE_V>();
            if(pendingOutput)WaitFlag<HardEvent::MTE3_V>(1);
            FromFloat<bfloat16_t>(out_,y_,d_);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(1);WaitFlag<HardEvent::V_MTE3>(1);
            DataCopyPad(outgm_[row*d_],out_,cp);SetFlag<HardEvent::MTE3_V>(1);pendingOutput=true;
        }
        if(pendingOutput)WaitFlag<HardEvent::MTE3_V>(1);
    }
private:
    __aicore__ inline void Prefetch(uint64_t row) {
        DataCopyExtParams cp={1,d_*2,0,0,0};DataCopyPadExtParams<bfloat16_t> pad={};pad.isPad=false;
        DataCopyPad(x_,xgm_[row*d_],cp,pad);DataCopyPad(r_,rgm_[row*d_],cp,pad);SetFlag<HardEvent::MTE2_V>(0);
    }
    GlobalTensor<bfloat16_t> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<bfloat16_t> x_,r_,out_;
    LocalTensor<float> y_,tmp_,gf_,bf_,work_,sum_;
    uint64_t begin_,end_;uint32_t d_,parts_;float invD_,eps_;
};
__global__ __vector__ void bf_static8_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState();BFloatStatic8Kernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class LongHalfRetainedKernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
        uint64_t rows,uint32_t d,float invD,float eps) {
        rows_=rows;d_=d;invD_=invD;eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ half*)x);rgm_.SetGlobalBuffer((__gm__ half*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ half*)g);bgm_.SetGlobalBuffer((__gm__ half*)b);outgm_.SetGlobalBuffer((__gm__ half*)out);
        x_[0]=LocalTensor<half>(TPosition::VECIN,0,8192);
        r_[0]=LocalTensor<half>(TPosition::VECIN,16512,8192);
        x_[1]=LocalTensor<half>(TPosition::VECIN,33024,8192);
        r_[1]=LocalTensor<half>(TPosition::VECIN,49536,8192);
        y_=LocalTensor<half>(TPosition::VECCALC,66048,32768);
        tmp_=LocalTensor<float>(TPosition::VECCALC,131712,8192);
        work_=LocalTensor<float>(TPosition::VECCALC,164608,1024);
        partial_=LocalTensor<float>(TPosition::VECCALC,168832,64);
        sum_=LocalTensor<float>(TPosition::VECCALC,169216,8);
        scale_=LocalTensor<half>(TPosition::VECCALC,169344,128);
        rawScale_=LocalTensor<half>(TPosition::VECCALC,169600,16);
    }
    __aicore__ inline void Process() {
        const uint64_t begin=rows_*GetBlockIdx()/GetBlockNum();
        const uint64_t end=rows_*(GetBlockIdx()+1)/GetBlockNum();
        const uint32_t chunks=(d_+8191)/8192;
        for(uint64_t row=begin;row<end;++row) {
            Duplicate(tmp_,0.0f,8192);PipeBarrier<PIPE_V>();
            Prefetch(row,0,0,false);if(chunks>1)Prefetch(row,8192,1,false);
            for(uint32_t c=0;c<chunks;++c) {
                const uint32_t col=c*8192,n=Min(8192,d_-col),padded=(n+63)/64*64,slot=c&1;
                WaitFlag<HardEvent::MTE2_V>(slot);
                Add(y_[col],x_[slot],r_[slot],n);PipeBarrier<PIPE_V>();
                if(c+2<chunks) {
                    SetFlag<HardEvent::V_MTE2>(slot);WaitFlag<HardEvent::V_MTE2>(slot);
                    Prefetch(row,col+16384,slot,false);
                } else {
                    // Final readers of each raw input slot must finish before
                    // the parameter phase reuses it for gamma/bias DMA.
                    SetFlag<HardEvent::V_MTE2>(slot);
                }
                // Mixed vmla squares half inputs directly into an FP32
                // accumulator, combining every retained 8192-element chunk.
                MulAddDst<float,half>(tmp_,y_[col],y_[col],n);PipeBarrier<PIPE_V>();
            }
            WholeReduceSum(work_,tmp_,64,128,1,1,8);PipeBarrier<PIPE_V>();
            Add(work_,work_,work_[64],64);PipeBarrier<PIPE_V>();
            WholeReduceSum(sum_,work_,64,1,1,1,8);PipeBarrier<PIPE_V>();
            Muls(sum_,sum_,invD_,1);PipeBarrier<PIPE_V>();
            Adds(sum_,sum_,eps_,1);PipeBarrier<PIPE_V>();
            Sqrt(sum_,sum_,1);Duplicate(work_,1.0f,8);PipeBarrier<PIPE_V>();
            Div(sum_,work_,sum_,1);PipeBarrier<PIPE_V>();
            Cast(rawScale_,sum_,RoundMode::CAST_RINT,1);PipeBarrier<PIPE_V>();
            Brcb(scale_,rawScale_,1,{1,8});PipeBarrier<PIPE_V>();
            WaitFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(1);
            Prefetch(row,0,0,true);if(chunks>1)Prefetch(row,8192,1,true);
            for(uint32_t c=0;c<chunks;++c) {
                const uint32_t col=c*8192,n=Min(8192,d_-col),slot=c&1;
                WaitFlag<HardEvent::MTE2_V>(slot);
                if(n>=128)Mul(y_[col],y_[col],scale_,128,static_cast<uint8_t>(n/128),{1,1,0,8,8,0});
                if(n%128)Mul(y_[col+n/128*128],y_[col+n/128*128],scale_,n%128,1,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                FusedMulAdd(y_[col],x_[slot],r_[slot],n);PipeBarrier<PIPE_V>();
                if(c+2<chunks) {
                    SetFlag<HardEvent::V_MTE2>(slot);WaitFlag<HardEvent::V_MTE2>(slot);
                    Prefetch(row,col+16384,slot,true);
                }
                SetFlag<HardEvent::V_MTE3>(2);WaitFlag<HardEvent::V_MTE3>(2);
                DataCopyExtParams cp={1,n*2,0,0,0};DataCopyPad(outgm_[row*d_+col],y_[col],cp);
            }
            // Retained output slices must drain before the next row overwrites them.
            PipeBarrier<PIPE_ALL>();
        }
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline void Prefetch(uint64_t row,uint32_t col,uint32_t slot,bool parameter) {
        const uint32_t n=Min(8192,d_-col);DataCopyExtParams cp={1,n*2,0,0,0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        if(parameter) {
            DataCopyPad(x_[slot],ggm_[col],cp,pad);DataCopyPad(r_[slot],bgm_[col],cp,pad);
        } else {
            DataCopyPad(x_[slot],xgm_[row*d_+col],cp,pad);DataCopyPad(r_[slot],rgm_[row*d_+col],cp,pad);
        }
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    GlobalTensor<half> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<half> x_[2],r_[2],y_,scale_,rawScale_;
    LocalTensor<float> tmp_,work_,partial_,sum_;
    uint64_t rows_;uint32_t d_;float invD_,eps_;
};
__global__ __vector__ void long_half_retained_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps) {
    InitSocState();LongHalfRetainedKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class HalfSharedResidualKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR out, uint64_t rows, uint32_t d, float invD, float eps)
    {
        d_=d; stride_=(d+63)/64*64; batch_=12800/stride_;
        begin_=rows*GetBlockIdx()/GetBlockNum();
        end_=rows*(GetBlockIdx()+1)/GetBlockNum(); invD_=invD; eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ half*)x); rgm_.SetGlobalBuffer((__gm__ half*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ half*)g); bgm_.SetGlobalBuffer((__gm__ half*)b);
        outgm_.SetGlobalBuffer((__gm__ half*)out);
        x_[0]=LocalTensor<half>(TPosition::VECIN,0,12800);
        x_[1]=LocalTensor<half>(TPosition::VECIN,25728,12800);
        r_[0]=LocalTensor<half>(TPosition::VECIN,51456,12800);
        r_[1]=r_[0];
        tmp_=LocalTensor<float>(TPosition::VECCALC,51456,12800);
        y_=LocalTensor<float>(TPosition::VECCALC,102784,12800);
        out_=LocalTensor<half>(TPosition::VECOUT,154112,12800);
        gh_=LocalTensor<half>(TPosition::VECIN,179840,1024);
        bh_=LocalTensor<half>(TPosition::VECIN,182016,1024);
        work_=LocalTensor<float>(TPosition::VECCALC,184192,1600);
        sums_=LocalTensor<float>(TPosition::VECCALC,190720,128);
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams parameter={1,static_cast<uint32_t>(d_*sizeof(half)),0,0,0};
        DataCopyPadExtParams<half> pad={}; pad.isPad=false;
        DataCopyPad(gh_,ggm_,parameter,pad); DataCopyPad(bh_,bgm_,parameter,pad);
        SetFlag<HardEvent::MTE2_V>(0); WaitFlag<HardEvent::MTE2_V>(0);
        if(!CompactParameterType<half>::value){ToFloat<half>(gamma_,gh_,d_);ToFloat<half>(bias_,bh_,d_);}
        PipeBarrier<PIPE_V>();
        Prefetch(begin_,0);
        if(begin_+batch_<end_) Prefetch(begin_+batch_,1);
        PrefetchResidual(begin_);
        bool pendingOutput=false;
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
            const uint32_t active=count*stride_;
            WaitFlag<HardEvent::MTE2_V>(slot);
            WaitFlag<HardEvent::MTE2_V>(2);
            if(CompactParameterType<half>::value) {
                Add(x_[slot],x_[slot],r_[slot],active);PipeBarrier<PIPE_V>();
                ToFloat<half>(y_,x_[slot],active);PipeBarrier<PIPE_V>();
            } else {
                ToFloat<half>(y_,x_[slot],active);ToFloat<half>(tmp_,r_[slot],active);PipeBarrier<PIPE_V>();
            }
            // This slot is only overwritten after both Cast source reads end.
            if(row+2*batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(slot); WaitFlag<HardEvent::V_MTE2>(slot);
                Prefetch(row+2*batch_,slot);
            }
            if(!CompactParameterType<half>::value){Add(y_,y_,tmp_,active);PipeBarrier<PIPE_V>();}
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                Duplicate(y_[d_/64*64],0.0f,tail,count,1,stride_/8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
            const uint32_t parts=stride_/64;
            if(true) {
                BlockReduceSum(work_,tmp_,active/64,64,1,1,8);
                PipeBarrier<PIPE_V>();
                const uint32_t partialRow=parts*8;
                if(partialRow>64) {
                    Add(work_,work_,work_[64],partialRow-64,count,
                        {1,1,1,static_cast<uint8_t>(parts),static_cast<uint8_t>(parts),static_cast<uint8_t>(parts)});
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceSum(sums_,work_,Min(64,partialRow),count,1,1,parts);
            } else if(parts<=8) {
                WholeReduceSum(work_,tmp_,64,active/64,8,1,8);
                PipeBarrier<PIPE_V>();
                uint64_t mask[2]={0,0};
                for(uint32_t p=0;p<parts;++p) mask[0]|=static_cast<uint64_t>(1)<<(p*8);
                WholeReduceSum(sums_,work_,mask,count,1,1,parts);
            } else {
                const uint32_t partialStride=(parts+7)/8*8;
                for(uint32_t i=0;i<count;++i)
                    WholeReduceSum(work_[i*partialStride],tmp_[i*stride_],64,parts,1,1,8);
                PipeBarrier<PIPE_V>();
                WholeReduceSum(sums_,work_,parts,count,1,1,partialStride/8);
            }
            PipeBarrier<PIPE_V>();
            // Square reduction is the last reader of the residual/square
            // alias. Refill it while the independent affine stage runs.
            if(row+batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(2);WaitFlag<HardEvent::V_MTE2>(2);
                PrefetchResidual(row+batch_);
            }
            Muls(sums_,sums_,invD_,count); PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count); PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count); Duplicate(work_,1.0f,count); PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count); PipeBarrier<PIPE_V>();
            const uint32_t rms=(count+7)/8*8;
            Brcb(work_,sums_,rms/8,{1,8}); PipeBarrier<PIPE_V>();
            if(count<=parts) {
                for(uint32_t i=0;i<count;++i)
                    Mul(y_[i*stride_],y_[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<half>::value)
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(y_[i*stride_],gamma_,bias_,d_);
            } else {
                const uint8_t step=stride_/8;
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y_[col],y_[col],work_,Min(64,d_-col),count,{1,1,0,step,step,1});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<half>::value)
                    for(uint32_t col=0;col<d_;col+=64)
                        FusedMulAdd(y_[col],gamma_[col],bias_[col],Min(64,d_-col),count,{1,1,1,step,0,0});
            }
            PipeBarrier<PIPE_V>();
            if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
            FromFloat<half>(out_,y_,active); PipeBarrier<PIPE_V>();
            if(CompactParameterType<half>::value) {
                const uint32_t halfParts=(d_+127)/128;
                if(count<=halfParts) {
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(out_[i*stride_].template ReinterpretCast<half>(),gh_.template ReinterpretCast<half>(),bh_.template ReinterpretCast<half>(),d_);
                } else {
                    for(uint32_t col=0;col<d_;col+=128)
                        FusedMulAdd(out_[col].template ReinterpretCast<half>(),gh_[col].template ReinterpretCast<half>(),bh_[col].template ReinterpretCast<half>(),Min(128,d_-col),count,
                            {1,1,1,static_cast<uint8_t>(stride_/16),0,0});
                }
                PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(2); WaitFlag<HardEvent::V_MTE3>(2);
            DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(half)),Gap(),0,0};
            DataCopyPad(outgm_[row*d_],out_,copy);
            SetFlag<HardEvent::MTE3_V>(3); pendingOutput=true;
        }
        if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*sizeof(half)-(static_cast<uint32_t>(d_*sizeof(half))+31)/32*32)/32;}
    __aicore__ inline void Prefetch(uint64_t row,uint32_t slot)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(half)),0,Gap(),0};
        DataCopyPadExtParams<half> pad={}; pad.isPad=false;
        DataCopyPad(x_[slot],xgm_[row*d_],copy,pad);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    __aicore__ inline void PrefetchResidual(uint64_t row) {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),d_*2,0,Gap(),0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(r_[0],rgm_[row*d_],copy,pad);
        SetFlag<HardEvent::MTE2_V>(2);
    }
    GlobalTensor<half> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<half> x_[2],r_[2],out_,gh_,bh_;
    LocalTensor<float> y_,tmp_,gamma_,bias_,work_,sums_;
    uint64_t begin_,end_; uint32_t d_,stride_,batch_; float invD_,eps_;
};
__global__ __vector__ void half_shared_residual_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps) {
    InitSocState();HalfSharedResidualKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class BFloatBatchPipelineKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR out, uint64_t rows, uint32_t d, float invD, float eps)
    {
        d_=d; stride_=(d+63)/64*64; batch_=8192/stride_;
        begin_=rows*GetBlockIdx()/GetBlockNum();
        end_=rows*(GetBlockIdx()+1)/GetBlockNum(); invD_=invD; eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ bfloat16_t*)x); rgm_.SetGlobalBuffer((__gm__ bfloat16_t*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ bfloat16_t*)g); bgm_.SetGlobalBuffer((__gm__ bfloat16_t*)b);
        outgm_.SetGlobalBuffer((__gm__ bfloat16_t*)out);
        x_[0]=LocalTensor<bfloat16_t>(TPosition::VECIN,0,8192);
        x_[1]=LocalTensor<bfloat16_t>(TPosition::VECIN,16512,8192);
        r_[0]=LocalTensor<bfloat16_t>(TPosition::VECIN,33024,8192);
        r_[1]=LocalTensor<bfloat16_t>(TPosition::VECIN,49536,8192);
        y_=LocalTensor<float>(TPosition::VECCALC,66048,8192);
        tmp_=LocalTensor<float>(TPosition::VECCALC,98944,8192);
        out_=LocalTensor<bfloat16_t>(TPosition::VECOUT,131840,8192);
        gamma_=LocalTensor<float>(TPosition::VECCALC,148352,4096);
        bias_=LocalTensor<float>(TPosition::VECCALC,164864,4096);
        gh_=x_[0];bh_=r_[0];
        work_=LocalTensor<float>(TPosition::VECCALC,181376,1024);
        sums_=LocalTensor<float>(TPosition::VECCALC,185600,128);
    }
    __aicore__ inline void Process()
    {
        DataCopyExtParams parameter={1,static_cast<uint32_t>(d_*sizeof(bfloat16_t)),0,0,0};
        DataCopyPadExtParams<bfloat16_t> pad={}; pad.isPad=false;
        DataCopyPad(gh_,ggm_,parameter,pad); DataCopyPad(bh_,bgm_,parameter,pad);
        SetFlag<HardEvent::MTE2_V>(0); WaitFlag<HardEvent::MTE2_V>(0);
        if(!CompactParameterType<bfloat16_t>::value){ToFloat<bfloat16_t>(gamma_,gh_,d_);ToFloat<bfloat16_t>(bias_,bh_,d_);}
        PipeBarrier<PIPE_V>();
        // Parameter Cast still reads the first raw input slots.
        SetFlag<HardEvent::V_MTE2>(3);WaitFlag<HardEvent::V_MTE2>(3);
        Prefetch(begin_,0);
        if(begin_+batch_<end_) Prefetch(begin_+batch_,1);
        bool pendingOutput=false;
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
            const uint32_t active=count*stride_;
            WaitFlag<HardEvent::MTE2_V>(slot);
            if(CompactParameterType<bfloat16_t>::value) {
                Add(x_[slot],x_[slot],r_[slot],active);PipeBarrier<PIPE_V>();
                ToFloat<bfloat16_t>(y_,x_[slot],active);PipeBarrier<PIPE_V>();
            } else {
                ToFloat<bfloat16_t>(y_,x_[slot],active);ToFloat<bfloat16_t>(tmp_,r_[slot],active);PipeBarrier<PIPE_V>();
            }
            // This slot is only overwritten after both Cast source reads end.
            if(row+2*batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(slot); WaitFlag<HardEvent::V_MTE2>(slot);
                Prefetch(row+2*batch_,slot);
            }
            if(!CompactParameterType<bfloat16_t>::value){Add(y_,y_,tmp_,active);PipeBarrier<PIPE_V>();}
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                for(uint32_t i=0;i<count;++i)
                    Duplicate(y_[i*stride_+d_/64*64],0.0f,tail,1,1,8);
                PipeBarrier<PIPE_V>();
            }
            Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
            const uint32_t parts=stride_/64;
            if(false) {
                BlockReduceSum(work_,tmp_,active/64,64,1,1,8);
                PipeBarrier<PIPE_V>();
                const uint32_t partialRow=parts*8;
                if(partialRow>64) {
                    Add(work_,work_,work_[64],partialRow-64,count,
                        {1,1,1,static_cast<uint8_t>(parts),static_cast<uint8_t>(parts),static_cast<uint8_t>(parts)});
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceSum(sums_,work_,Min(64,partialRow),count,1,1,parts);
            } else if(parts<=8) {
                WholeReduceSum(work_,tmp_,64,active/64,8,1,8);
                PipeBarrier<PIPE_V>();
                uint64_t mask[2]={0,0};
                for(uint32_t p=0;p<parts;++p) mask[0]|=static_cast<uint64_t>(1)<<(p*8);
                WholeReduceSum(sums_,work_,mask,count,1,1,parts);
            } else {
                const uint32_t partialStride=(parts+7)/8*8;
                for(uint32_t i=0;i<count;++i)
                    WholeReduceSum(work_[i*partialStride],tmp_[i*stride_],64,parts,1,1,8);
                PipeBarrier<PIPE_V>();
                WholeReduceSum(sums_,work_,parts,count,1,1,partialStride/8);
            }
            PipeBarrier<PIPE_V>();
            Muls(sums_,sums_,invD_,count); PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count); PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count); Duplicate(work_,1.0f,count); PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count); PipeBarrier<PIPE_V>();
            const uint32_t rms=(count+7)/8*8;
            Brcb(work_,sums_,rms/8,{1,8}); PipeBarrier<PIPE_V>();
            if(count<=parts) {
                for(uint32_t i=0;i<count;++i)
                    Mul(y_[i*stride_],y_[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<bfloat16_t>::value)
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(y_[i*stride_],gamma_,bias_,d_);
            } else {
                const uint8_t step=stride_/8;
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y_[col],y_[col],work_,Min(64,d_-col),count,{1,1,0,step,step,1});
                PipeBarrier<PIPE_V>();
                if(!CompactParameterType<bfloat16_t>::value)
                    for(uint32_t col=0;col<d_;col+=64)
                        FusedMulAdd(y_[col],gamma_[col],bias_[col],Min(64,d_-col),count,{1,1,1,step,0,0});
            }
            PipeBarrier<PIPE_V>();
            if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
            FromFloat<bfloat16_t>(out_,y_,active); PipeBarrier<PIPE_V>();
            if(CompactParameterType<bfloat16_t>::value) {
                const uint32_t halfParts=(d_+127)/128;
                if(count<=halfParts) {
                    for(uint32_t i=0;i<count;++i)FusedMulAdd(out_[i*stride_].template ReinterpretCast<half>(),gh_.template ReinterpretCast<half>(),bh_.template ReinterpretCast<half>(),d_);
                } else {
                    for(uint32_t col=0;col<d_;col+=128)
                        FusedMulAdd(out_[col].template ReinterpretCast<half>(),gh_[col].template ReinterpretCast<half>(),bh_[col].template ReinterpretCast<half>(),Min(128,d_-col),count,
                            {1,1,1,static_cast<uint8_t>(stride_/16),0,0});
                }
                PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(2); WaitFlag<HardEvent::V_MTE3>(2);
            DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(bfloat16_t)),Gap(),0,0};
            DataCopyPad(outgm_[row*d_],out_,copy);
            SetFlag<HardEvent::MTE3_V>(3); pendingOutput=true;
        }
        if(pendingOutput) WaitFlag<HardEvent::MTE3_V>(3);
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*sizeof(bfloat16_t)-(static_cast<uint32_t>(d_*sizeof(bfloat16_t))+31)/32*32)/32;}
    __aicore__ inline void Prefetch(uint64_t row,uint32_t slot)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams copy={static_cast<uint16_t>(count),static_cast<uint32_t>(d_*sizeof(bfloat16_t)),0,Gap(),0};
        DataCopyPadExtParams<bfloat16_t> pad={}; pad.isPad=false;
        DataCopyPad(x_[slot],xgm_[row*d_],copy,pad);
        DataCopyPad(r_[slot],rgm_[row*d_],copy,pad);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    GlobalTensor<bfloat16_t> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<bfloat16_t> x_[2],r_[2],out_,gh_,bh_;
    LocalTensor<float> y_,tmp_,gamma_,bias_,work_,sums_;
    uint64_t begin_,end_; uint32_t d_,stride_,batch_; float invD_,eps_;
};
__global__ __vector__ void bfloat_batch_pipeline_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps) {
    InitSocState();BFloatBatchPipelineKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class BFloatShortInplaceKernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
        uint64_t rows,float eps) {
        begin_=rows*GetBlockIdx()/GetBlockNum();end_=rows*(GetBlockIdx()+1)/GetBlockNum();eps_=eps;
        xgm_.SetGlobalBuffer((__gm__ bfloat16_t*)x);rgm_.SetGlobalBuffer((__gm__ bfloat16_t*)r);ConfigureLargeInputCache(xgm_,rgm_,rows,128);
        ggm_.SetGlobalBuffer((__gm__ bfloat16_t*)g);bgm_.SetGlobalBuffer((__gm__ bfloat16_t*)b);outgm_.SetGlobalBuffer((__gm__ bfloat16_t*)out);
        x_[0]=LocalTensor<bfloat16_t>(TPosition::VECIN,0,15232);
        x_[1]=LocalTensor<bfloat16_t>(TPosition::VECIN,30592,15232);
        tmp_=LocalTensor<float>(TPosition::VECCALC,61184,15232);r_=tmp_.ReinterpretCast<bfloat16_t>();
        y_=LocalTensor<float>(TPosition::VECCALC,122240,15232);
        gf_=LocalTensor<float>(TPosition::VECCALC,183296,128);
        bf_=LocalTensor<float>(TPosition::VECCALC,183936,128);
        work_=LocalTensor<float>(TPosition::VECCALC,184576,1952);
        sums_=LocalTensor<float>(TPosition::VECCALC,192512,128);
    }
    __aicore__ inline void Process() {
        DataCopyParams parameter={1,8,0,0};
        DataCopy(x_[0],ggm_,parameter);DataCopy(r_,bgm_,parameter);
        SetFlag<HardEvent::MTE2_V>(3);WaitFlag<HardEvent::MTE2_V>(3);
        Cast(gf_,x_[0],RoundMode::CAST_NONE,128);Cast(bf_,r_,RoundMode::CAST_NONE,128);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(3);WaitFlag<HardEvent::V_MTE2>(3);
        Copy(x_[0],xgm_,begin_);SetFlag<HardEvent::MTE2_V>(0);
        Copy(r_,rgm_,begin_);SetFlag<HardEvent::MTE2_V>(2);
        if(begin_+119<end_) {Copy(x_[1],xgm_,begin_+119);SetFlag<HardEvent::MTE2_V>(1);}
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=119,slot^=1) {
            WaitFlag<HardEvent::MTE2_V>(slot);WaitFlag<HardEvent::MTE2_V>(2);
            const uint32_t count=Min(119,static_cast<uint32_t>(end_-row)),active=count*128;
            // Cast residual out of the aliased square area before overwriting it with X.
            Cast(y_,r_,RoundMode::CAST_NONE,active);PipeBarrier<PIPE_V>();
            Cast(tmp_,x_[slot],RoundMode::CAST_NONE,active);PipeBarrier<PIPE_V>();
            Add(y_,y_,tmp_,active);PipeBarrier<PIPE_V>();
            Mul(tmp_,y_,y_,active);PipeBarrier<PIPE_V>();
            BlockReduceSum(work_,tmp_,active/64,64,1,1,8);PipeBarrier<PIPE_V>();
            WholeReduceSum(sums_,work_,16,count,1,1,2);PipeBarrier<PIPE_V>();
            if(row+119<end_) {
                SetFlag<HardEvent::V_MTE2>(2);WaitFlag<HardEvent::V_MTE2>(2);
                Copy(r_,rgm_,row+119);SetFlag<HardEvent::MTE2_V>(2);
            }
            Muls(sums_,sums_,0.0078125f,count);PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count);Duplicate(work_,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count);PipeBarrier<PIPE_V>();
            Brcb(work_,sums_,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
            Mul(y_,y_,work_,64,count,{1,1,0,16,16,1});
            Mul(y_[64],y_[64],work_,64,count,{1,1,0,16,16,1});PipeBarrier<PIPE_V>();
            FusedMulAdd(y_,gf_,bf_,64,count,{1,1,1,16,0,0});
            FusedMulAdd(y_[64],gf_[64],bf_[64],64,count,{1,1,1,16,0,0});PipeBarrier<PIPE_V>();
            Cast(x_[slot],y_,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
            DataCopyParams output={1,static_cast<uint16_t>(count*8),0,0};
            DataCopy(outgm_[row*128],x_[slot],output);
            SetFlag<HardEvent::MTE3_MTE2>(slot);WaitFlag<HardEvent::MTE3_MTE2>(slot);
            if(row+238<end_) {Copy(x_[slot],xgm_,row+238);SetFlag<HardEvent::MTE2_V>(slot);}
        }
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline void Copy(LocalTensor<bfloat16_t> dst,GlobalTensor<bfloat16_t> src,uint64_t row) {
        const uint32_t count=Min(119,static_cast<uint32_t>(end_-row));
        DataCopyParams cp={1,static_cast<uint16_t>(count*8),0,0};DataCopy(dst,src[row*128],cp);
    }
    GlobalTensor<bfloat16_t> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<bfloat16_t> x_[2],r_;LocalTensor<float> tmp_,y_,gf_,bf_,work_,sums_;
    uint64_t begin_,end_;float eps_;
};
__global__ __vector__ void bfloat_short_inplace_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,float eps) {
    InitSocState();BFloatShortInplaceKernel op;op.Init(x,r,g,b,out,rows,eps);op.Process();
}

class StaticHalfRowsKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR out, uint64_t rows, uint32_t d, float invD, float eps)
    {
        d_ = d; stride_ = (d + 63) / 64 * 64; invD_ = invD; eps_ = eps;
        begin_ = rows * GetBlockIdx() / GetBlockNum();
        count_ = static_cast<uint32_t>(rows * (GetBlockIdx()+1) / GetBlockNum() - begin_);
        xgm_.SetGlobalBuffer((__gm__ half*)x); rgm_.SetGlobalBuffer((__gm__ half*)r);
        ggm_.SetGlobalBuffer((__gm__ half*)g); bgm_.SetGlobalBuffer((__gm__ half*)b);
        outgm_.SetGlobalBuffer((__gm__ half*)out);
        x_ = LocalTensor<half>(TPosition::VECIN, 0, 8192);
        r_ = LocalTensor<half>(TPosition::VECIN, 16512, 8192);
        y_ = LocalTensor<float>(TPosition::VECCALC, 33024, 8192);
        tmp_ = LocalTensor<float>(TPosition::VECCALC, 65920, 8192);
        gamma_ = LocalTensor<float>(TPosition::VECCALC, 98816, 256);
        bias_ = LocalTensor<float>(TPosition::VECCALC, 100096, 256);
        gh_ = LocalTensor<half>(TPosition::VECIN, 101248, 256);
        bh_ = LocalTensor<half>(TPosition::VECIN, 101888, 256);
        work_ = LocalTensor<float>(TPosition::VECCALC, 102528, 1024);
        sums_ = LocalTensor<float>(TPosition::VECCALC, 106752, 32);
    }
    __aicore__ inline void Process()
    {
        const uint32_t active = count_ * stride_;
        const uint32_t gap = (stride_*2 - (d_*2+31)/32*32)/32;
        DataCopyExtParams batch = {static_cast<uint16_t>(count_),d_*2,0,gap,0};
        DataCopyExtParams params = {1,d_*2,0,0,0};
        DataCopyPadExtParams<half> pad = {}; pad.isPad = false;
        DataCopyPad(x_,xgm_[begin_*d_],batch,pad);
        DataCopyPad(r_,rgm_[begin_*d_],batch,pad);
        DataCopyPad(gh_,ggm_,params,pad); DataCopyPad(bh_,bgm_,params,pad);
        SetFlag<HardEvent::MTE2_V>(0); WaitFlag<HardEvent::MTE2_V>(0);
        Add(x_,x_,r_,active);PipeBarrier<PIPE_V>();
        ToFloat<half>(y_,x_,active);PipeBarrier<PIPE_V>();
        if(d_!=stride_) {
            uint64_t tail[2] = {~static_cast<uint64_t>(0) << (d_%64),0};
            Duplicate(y_[d_/64*64],0.0f,tail,static_cast<uint8_t>(count_),1,
                static_cast<uint8_t>(stride_/8)); PipeBarrier<PIPE_V>();
        }
        Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
        const uint32_t parts = stride_/64;
        const uint32_t rms = (count_+7)/8*8;
        BlockReduceSum(work_,tmp_,active/64,64,1,1,8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(sums_,work_,static_cast<int32_t>(stride_/8),count_,1,1,parts);
        PipeBarrier<PIPE_V>();
        Muls(sums_,sums_,invD_,rms); PipeBarrier<PIPE_V>();
        Adds(sums_,sums_,eps_,rms); PipeBarrier<PIPE_V>();
        Sqrt(sums_,sums_,rms);
        Duplicate(work_,1.0f,rms); PipeBarrier<PIPE_V>();
        Div(sums_,work_,sums_,rms); PipeBarrier<PIPE_V>();
        auto scales=work_[768].ReinterpretCast<half>();
        auto broadcast=work_.ReinterpretCast<half>();
        Cast(scales,sums_,RoundMode::CAST_RINT,count_);PipeBarrier<PIPE_V>();
        Brcb(broadcast,scales,static_cast<uint8_t>(rms/8),{1,8});PipeBarrier<PIPE_V>();
        const uint8_t repeats=static_cast<uint8_t>(count_);
        const uint8_t rb=static_cast<uint8_t>(stride_/16);
        for(uint32_t col=0;col<d_;col+=128)
            Mul(x_[col],x_[col],broadcast,static_cast<uint64_t>(d_-col<128?d_-col:128),repeats,{1,1,0,rb,rb,1});
        PipeBarrier<PIPE_V>();
        for(uint32_t col=0;col<d_;col+=128)
            FusedMulAdd(x_[col],gh_[col],bh_[col],static_cast<uint64_t>(d_-col<128?d_-col:128),repeats,{1,1,1,rb,0,0});
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(1); WaitFlag<HardEvent::V_MTE3>(1);
        DataCopyExtParams out = {static_cast<uint16_t>(count_),d_*2,gap,0,0};
        DataCopyPad(outgm_[begin_*d_],x_,out);
        SetFlag<HardEvent::MTE3_V>(2); WaitFlag<HardEvent::MTE3_V>(2);
    }
private:
    GlobalTensor<half> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<half> x_,r_,gh_,bh_;
    LocalTensor<float> y_,tmp_,gamma_,bias_,work_,sums_;
    uint64_t begin_; uint32_t d_,stride_,count_; float invD_,eps_;
};
__global__ __vector__ void static_half_rows_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState(); StaticHalfRowsKernel op;
    op.Init(x,r,g,b,out,rows,d,invD,eps); op.Process();
}

class HalfGridSeed64Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR out, uint64_t rows, uint32_t d, float invD, float eps)
    {
        d_ = d; stride_ = (d + 63) / 64 * 64; invD_ = invD; eps_ = eps;
        begin_ = rows * GetBlockIdx() / GetBlockNum();
        count_ = static_cast<uint32_t>(rows * (GetBlockIdx()+1) / GetBlockNum() - begin_);
        xgm_.SetGlobalBuffer((__gm__ half*)x); rgm_.SetGlobalBuffer((__gm__ half*)r);
        ggm_.SetGlobalBuffer((__gm__ half*)g); bgm_.SetGlobalBuffer((__gm__ half*)b);
        outgm_.SetGlobalBuffer((__gm__ half*)out);
        x_ = LocalTensor<half>(TPosition::VECIN, 0, 8192);
        r_ = LocalTensor<half>(TPosition::VECIN, 16512, 8192);
        rawX_ = LocalTensor<half>(TPosition::VECIN, 33024, 8192);
        rawR_ = LocalTensor<half>(TPosition::VECIN, 49536, 8192);
        y_ = LocalTensor<float>(TPosition::VECCALC, 66048, 8192);
        tmp_ = LocalTensor<float>(TPosition::VECCALC, 98944, 8192);
        offsets_ = LocalTensor<int32_t>(TPosition::VECCALC, 131840, 8192);
        gh_ = LocalTensor<half>(TPosition::VECIN, 164736, 256);
        bh_ = LocalTensor<half>(TPosition::VECIN, 165376, 256);
        work_ = LocalTensor<float>(TPosition::VECCALC, 166016, 1024);
        sums_ = LocalTensor<float>(TPosition::VECCALC, 170240, 32);
    }
    __aicore__ inline void Process()
    {
        const uint32_t active = count_ * stride_;
        const uint32_t gap = (stride_*2 - (d_*2+31)/32*32)/32;
        DataCopyExtParams packed = {1,count_*d_*2,0,0,0};
        DataCopyExtParams params = {1,d_*2,0,0,0};
        DataCopyPadExtParams<half> pad = {}; pad.isPad = false;
        // Read exactly the valid dense rows. Gather changes only UB layout.
        DataCopyPad(rawX_,xgm_[begin_*d_],packed,pad);
        DataCopyPad(rawR_,rgm_[begin_*d_],packed,pad);
        SetFlag<HardEvent::MTE2_V>(0);
        DataCopyPad(gh_,ggm_,params,pad); DataCopyPad(bh_,bgm_,params,pad);
        SetFlag<HardEvent::MTE2_V>(1);
        MakeOffsets(active);
        WaitFlag<HardEvent::MTE2_V>(0);
        // FP16 rounding is identical to Add after Gather for every valid
        // lane. Gather only the already-added residual, cutting one Gather.
        Add(rawX_,rawX_,rawR_,count_*d_);PipeBarrier<PIPE_V>();
        auto byteOffsets=offsets_.ReinterpretCast<uint32_t>();
        Gather(x_,rawX_,byteOffsets,0,active);
        PipeBarrier<PIPE_V>();
        ToFloat<half>(y_,x_,active);PipeBarrier<PIPE_V>();
        if(d_!=stride_) {
            uint64_t tail[2] = {~static_cast<uint64_t>(0) << (d_%64),0};
            Duplicate(y_[d_/64*64],0.0f,tail,static_cast<uint8_t>(count_),1,
                static_cast<uint8_t>(stride_/8)); PipeBarrier<PIPE_V>();
        }
        Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
        const uint32_t parts = stride_/64;
        const uint32_t rms = (count_+7)/8*8;
        BlockReduceSum(work_,tmp_,active/64,64,1,1,8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(sums_,work_,static_cast<int32_t>(stride_/8),count_,1,1,parts);
        PipeBarrier<PIPE_V>();
        Muls(sums_,sums_,invD_,rms); PipeBarrier<PIPE_V>();
        Adds(sums_,sums_,eps_,rms); PipeBarrier<PIPE_V>();
        Sqrt(sums_,sums_,rms);
        Duplicate(work_,1.0f,rms); PipeBarrier<PIPE_V>();
        Div(sums_,work_,sums_,rms); PipeBarrier<PIPE_V>();
        auto scales=work_[768].ReinterpretCast<half>();
        auto broadcast=work_.ReinterpretCast<half>();
        Cast(scales,sums_,RoundMode::CAST_RINT,count_);PipeBarrier<PIPE_V>();
        Brcb(broadcast,scales,static_cast<uint8_t>(rms/8),{1,8});PipeBarrier<PIPE_V>();
        const uint8_t repeats=static_cast<uint8_t>(count_);
        const uint8_t rb=static_cast<uint8_t>(stride_/16);
        for(uint32_t col=0;col<d_;col+=128)
            Mul(x_[col],x_[col],broadcast,static_cast<uint64_t>(d_-col<128?d_-col:128),repeats,{1,1,0,rb,rb,1});
        PipeBarrier<PIPE_V>();
        WaitFlag<HardEvent::MTE2_V>(1);
        for(uint32_t col=0;col<d_;col+=128)
            FusedMulAdd(x_[col],gh_[col],bh_[col],static_cast<uint64_t>(d_-col<128?d_-col:128),repeats,{1,1,1,rb,0,0});
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(1); WaitFlag<HardEvent::V_MTE3>(1);
        DataCopyExtParams out = {static_cast<uint16_t>(count_),d_*2,gap,0,0};
        DataCopyPad(outgm_[begin_*d_],x_,out);
        SetFlag<HardEvent::MTE3_V>(2); WaitFlag<HardEvent::MTE3_V>(2);
    }
    __aicore__ inline void MakeOffsets(uint32_t active)
    {
        // One shared column table per invocation, expanded to a full grid.
        // This follows the static integer Adds/S_V pattern used in FPACK3.
        for(uint32_t col=0;col<64;++col)
            offsets_.SetValue(col,static_cast<int32_t>(col*2));
        SetFlag<HardEvent::S_V>(3);WaitFlag<HardEvent::S_V>(3);
        Adds(offsets_[64],offsets_,static_cast<int32_t>(128),64);
        Adds(offsets_[128],offsets_,static_cast<int32_t>(256),64);
        Adds(offsets_[192],offsets_,static_cast<int32_t>(384),64);
        PipeBarrier<PIPE_V>();
        uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
        Duplicate(offsets_[192],static_cast<int32_t>((d_-1)*2),tail,1,1,8);
        PipeBarrier<PIPE_V>();
        for(uint32_t row=1;row<count_;++row)
            Adds(offsets_[row*256],offsets_,static_cast<int32_t>(row*d_*2),256);
        PipeBarrier<PIPE_V>();
    }
private:
    GlobalTensor<half> xgm_,rgm_,ggm_,bgm_,outgm_;
    LocalTensor<half> x_,r_,rawX_,rawR_,gh_,bh_;
    LocalTensor<int32_t> offsets_;
    LocalTensor<float> y_,tmp_,gamma_,bias_,work_,sums_;
    uint64_t begin_; uint32_t d_,stride_,count_; float invD_,eps_;
};
__global__ __vector__ void half_grid_seed64_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState(); HalfGridSeed64Kernel op;
    op.Init(x,r,g,b,out,rows,d,invD,eps); op.Process();
}

// At most four FP32 short rows per core. One DMA batch and two vector reductions.
// Static UB avoids the queue setup overhead for these small launch geometries.
class ShortFloatPartitionKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint64_t rows, uint32_t d,
                               float inverseD, float epsilon)
    {
        d_ = d;
        stride_ = (d + 63) / 64 * 64;
        begin_ = rows * GetBlockIdx() / GetBlockNum();
        const uint64_t end = rows * (GetBlockIdx() + 1) / GetBlockNum();
        count_ = static_cast<uint32_t>(end - begin_);
        invD_ = inverseD;
        eps_ = epsilon;
        xgm_.SetGlobalBuffer((__gm__ float*)x);
        rgm_.SetGlobalBuffer((__gm__ float*)r);
        ggm_.SetGlobalBuffer((__gm__ float*)g);
        bgm_.SetGlobalBuffer((__gm__ float*)b);
        outgm_.SetGlobalBuffer((__gm__ float*)out);
        // Four padded 512-element rows fit in each 8192 B data slot.
        // Operand starts are shifted; this is measured rather than assumed faster.
        y_ = LocalTensor<float>(TPosition::VECIN, 0, 8192);
        tmp_ = LocalTensor<float>(TPosition::VECIN, 32896, 8192);
        gamma_ = LocalTensor<float>(TPosition::VECIN, 65792, 512);
        bias_ = LocalTensor<float>(TPosition::VECIN, 67968, 512);
        work_ = LocalTensor<float>(TPosition::VECCALC, 70144, 1024);
        sums_ = LocalTensor<float>(TPosition::VECCALC, 74368, 64);
    }

    __aicore__ inline void Process()
    {
        const uint32_t active = count_ * stride_;
        const uint32_t gap = (stride_ * 4 - (d_ * 4 + 31) / 32 * 32) / 32;
        DataCopyExtParams batch = {static_cast<uint16_t>(count_), d_ * 4, 0, gap, 0};
        DataCopyExtParams parameter = {1, d_ * 4, 0, 0, 0};
        DataCopyPadExtParams<float> pad = {};
        pad.isPad = false;
        DataCopyPad(y_, xgm_[begin_ * d_], batch, pad);
        DataCopyPad(tmp_, rgm_[begin_ * d_], batch, pad);
        DataCopyPad(gamma_, ggm_, parameter, pad);
        DataCopyPad(bias_, bgm_, parameter, pad);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Add(y_, y_, tmp_, active);
        PipeBarrier<PIPE_V>();
        if (d_ != stride_) {
            uint64_t tail[2] = {~static_cast<uint64_t>(0) << (d_ % 64), 0};
            Duplicate(y_[d_ / 64 * 64], 0.0f, tail, static_cast<uint8_t>(count_),
                      1, static_cast<uint8_t>(stride_ / 8));
            PipeBarrier<PIPE_V>();
        }
        Mul(tmp_, y_, y_, active);
        PipeBarrier<PIPE_V>();
        Duplicate(sums_, 1.0f, (count_+7)/8*8);
        BlockReduceSum(work_, tmp_, static_cast<int32_t>(active / 64), 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(sums_, work_, static_cast<int32_t>(stride_ / 8),
                       static_cast<int32_t>(count_), 1, 1,
                       static_cast<uint8_t>(stride_ / 64));
        PipeBarrier<PIPE_V>();
        Muls(sums_, sums_, invD_, count_);
        PipeBarrier<PIPE_V>();
        Adds(sums_, sums_, eps_, count_);
        PipeBarrier<PIPE_V>();
        Sqrt(sums_, sums_, count_);
        Duplicate(work_, 1.0f, count_);
        PipeBarrier<PIPE_V>();
        Div(sums_, work_, sums_, count_);
        PipeBarrier<PIPE_V>();
        Brcb(work_, sums_, (count_+7)/8, {1, 8});
        PipeBarrier<PIPE_V>();
        const uint8_t repeats = static_cast<uint8_t>(count_);
        const uint8_t rowBlocks = static_cast<uint8_t>(stride_ / 8);
        for (uint32_t col = 0; col < d_; col += 64) {
            const uint64_t mask = d_ - col < 64 ? d_ - col : 64;
            Mul(y_[col], y_[col], work_, mask, repeats, {1, 1, 0, rowBlocks, rowBlocks, 1});
        }
        PipeBarrier<PIPE_V>();
        for (uint32_t col = 0; col < d_; col += 64) {
            const uint64_t mask = d_ - col < 64 ? d_ - col : 64;
            FusedMulAdd(y_[col], gamma_[col], bias_[col], mask, repeats,
                        {1, 1, 1, rowBlocks, 0, 0});
        }
        PipeBarrier<PIPE_V>();
        Adds(y_, y_, 0.0f, active);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(1);
        WaitFlag<HardEvent::V_MTE3>(1);
        DataCopyExtParams output = {static_cast<uint16_t>(count_), d_ * 4, gap, 0, 0};
        DataCopyPad(outgm_[begin_ * d_], y_, output);
        SetFlag<HardEvent::MTE3_V>(2);
        WaitFlag<HardEvent::MTE3_V>(2);
    }
private:
    GlobalTensor<float> xgm_, rgm_, ggm_, bgm_, outgm_;
    LocalTensor<float> y_, tmp_, gamma_, bias_, work_, sums_;
    uint64_t begin_;
    uint32_t d_, stride_, count_;
    float invD_, eps_;
};

__global__ __vector__ void short_float_partition_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR out,
    uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState();ShortFloatPartitionKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

class TinyBatchFloatKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
                               GM_ADDR out, uint64_t rows, uint32_t d,
                               float inverseD, float epsilon)
    {
        d_ = d;
        stride_ = (d + 63) / 64 * 64;
        begin_ = rows * GetBlockIdx() / GetBlockNum();
        const uint64_t end = rows * (GetBlockIdx() + 1) / GetBlockNum();
        count_ = static_cast<uint32_t>(end - begin_);
        invD_ = inverseD;
        eps_ = epsilon;
        xgm_.SetGlobalBuffer((__gm__ float*)x);
        rgm_.SetGlobalBuffer((__gm__ float*)r);
        ggm_.SetGlobalBuffer((__gm__ float*)g);
        bgm_.SetGlobalBuffer((__gm__ float*)b);
        outgm_.SetGlobalBuffer((__gm__ float*)out);
        // Four padded 512-element rows fit in each 8192 B data slot.
        // Operand starts are shifted; this is measured rather than assumed faster.
        y_ = LocalTensor<float>(TPosition::VECIN, 0, 2048);
        tmp_ = LocalTensor<float>(TPosition::VECIN, 8320, 2048);
        gamma_ = LocalTensor<float>(TPosition::VECIN, 16640, 512);
        bias_ = LocalTensor<float>(TPosition::VECIN, 19328, 512);
        work_ = LocalTensor<float>(TPosition::VECCALC, 21504, 256);
        sums_ = LocalTensor<float>(TPosition::VECCALC, 22528, 8);
    }

    __aicore__ inline void Process()
    {
        const uint32_t active = count_ * stride_;
        const uint32_t gap = (stride_ * 4 - (d_ * 4 + 31) / 32 * 32) / 32;
        DataCopyExtParams batch = {static_cast<uint16_t>(count_), d_ * 4, 0, gap, 0};
        DataCopyExtParams parameter = {1, d_ * 4, 0, 0, 0};
        DataCopyPadExtParams<float> pad = {};
        pad.isPad = false;
        DataCopyPad(y_, xgm_[begin_ * d_], batch, pad);
        DataCopyPad(tmp_, rgm_[begin_ * d_], batch, pad);
        DataCopyPad(gamma_, ggm_, parameter, pad);
        DataCopyPad(bias_, bgm_, parameter, pad);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Add(y_, y_, tmp_, active);
        PipeBarrier<PIPE_V>();
        if (d_ != stride_) {
            uint64_t tail[2] = {~static_cast<uint64_t>(0) << (d_ % 64), 0};
            Duplicate(y_[d_ / 64 * 64], 0.0f, tail, static_cast<uint8_t>(count_),
                      1, static_cast<uint8_t>(stride_ / 8));
            PipeBarrier<PIPE_V>();
        }
        Mul(tmp_, y_, y_, active);
        PipeBarrier<PIPE_V>();
        Duplicate(sums_, 1.0f, 8);
        BlockReduceSum(work_, tmp_, static_cast<int32_t>(active / 64), 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(sums_, work_, static_cast<int32_t>(stride_ / 8),
                       static_cast<int32_t>(count_), 1, 1,
                       static_cast<uint8_t>(stride_ / 64));
        PipeBarrier<PIPE_V>();
        Muls(sums_, sums_, invD_, 8);
        PipeBarrier<PIPE_V>();
        Adds(sums_, sums_, eps_, 8);
        PipeBarrier<PIPE_V>();
        Sqrt(sums_, sums_, 8);
        Duplicate(work_, 1.0f, 8);
        PipeBarrier<PIPE_V>();
        Div(sums_, work_, sums_, 8);
        PipeBarrier<PIPE_V>();
        Brcb(work_, sums_, 1, {1, 8});
        PipeBarrier<PIPE_V>();
        const uint8_t repeats = static_cast<uint8_t>(count_);
        const uint8_t rowBlocks = static_cast<uint8_t>(stride_ / 8);
        for (uint32_t col = 0; col < d_; col += 64) {
            const uint64_t mask = d_ - col < 64 ? d_ - col : 64;
            Mul(y_[col], y_[col], work_, mask, repeats, {1, 1, 0, rowBlocks, rowBlocks, 1});
        }
        PipeBarrier<PIPE_V>();
        for (uint32_t col = 0; col < d_; col += 64) {
            const uint64_t mask = d_ - col < 64 ? d_ - col : 64;
            FusedMulAdd(y_[col], gamma_[col], bias_[col], mask, repeats,
                        {1, 1, 1, rowBlocks, 0, 0});
        }
        PipeBarrier<PIPE_V>();
        Adds(y_, y_, 0.0f, active);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(1);
        WaitFlag<HardEvent::V_MTE3>(1);
        DataCopyExtParams output = {static_cast<uint16_t>(count_), d_ * 4, gap, 0, 0};
        DataCopyPad(outgm_[begin_ * d_], y_, output);
        SetFlag<HardEvent::MTE3_V>(2);
        WaitFlag<HardEvent::MTE3_V>(2);
    }
private:
    GlobalTensor<float> xgm_, rgm_, ggm_, bgm_, outgm_;
    LocalTensor<float> y_, tmp_, gamma_, bias_, work_, sums_;
    uint64_t begin_;
    uint32_t d_, stride_, count_;
    float invD_, eps_;
};

__global__ __vector__ void tiny_batch_float_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t d, float invD, float eps)
{
    InitSocState();
    TinyBatchFloatKernel op;
    op.Init(x, residual, gamma, bias, output, rows, d, invD, eps);
    op.Process();
}


// FP16 medium rows: two X slots, one residual aliased with square scratch,
// and output in the consumed X slot. All lifetimes are explicitly fenced.
class HalfMediumDenseKernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR o,
        uint64_t rows,uint32_t d,float invD,float eps)
    {
        d_=d;stride_=(d+63)/64*64;batch_=11520/stride_;invD_=invD;eps_=eps;
        begin_=rows*GetBlockIdx()/GetBlockNum();
        end_=rows*(GetBlockIdx()+1)/GetBlockNum();
        xgm_.SetGlobalBuffer((__gm__ half*)x);rgm_.SetGlobalBuffer((__gm__ half*)r);
        ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ half*)g);bgm_.SetGlobalBuffer((__gm__ half*)b);
        ogm_.SetGlobalBuffer((__gm__ half*)o);
        x_[0]=LocalTensor<half>(TPosition::VECIN,0,11520);
        x_[1]=LocalTensor<half>(TPosition::VECIN,23168,11520);
        tmp_=LocalTensor<float>(TPosition::VECCALC,46336,11520);
        residual_=tmp_.ReinterpretCast<half>();
        y_=LocalTensor<float>(TPosition::VECCALC,92544,11520);
        offsets_=LocalTensor<int32_t>(TPosition::VECCALC,138752,11520);
        gh_=LocalTensor<half>(TPosition::VECIN,184960,512);
        bh_=LocalTensor<half>(TPosition::VECIN,186112,512);
        work_=LocalTensor<float>(TPosition::VECCALC,187264,1440);
        sums_=LocalTensor<float>(TPosition::VECCALC,193152,64);
    }
    __aicore__ inline void Process()
    {
        if(begin_>=end_)return;
        CopyX(begin_,0);CopyResidual(begin_);
        if(begin_+batch_<end_)CopyX(begin_+batch_,1);
        DataCopyExtParams cp={1,d_*2,0,0,0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(gh_,ggm_,cp,pad);DataCopyPad(bh_,bgm_,cp,pad);
        SetFlag<HardEvent::MTE2_V>(3);
        PrepareOffsets();
        bool pending[2]={false,false};
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            WaitFlag<HardEvent::MTE2_V>(slot);WaitFlag<HardEvent::MTE2_V>(2);
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
            const uint32_t active=count*stride_,parts=stride_/64;
            Add(x_[slot],x_[slot],residual_,count*d_);PipeBarrier<PIPE_V>();
            // The dense residual input is dead. Gather the added X into that
            // space, then Cast into the disjoint Y before square overwrites it.
            auto byteOffsets=offsets_.ReinterpretCast<uint32_t>();
            Gather(residual_,x_[slot],byteOffsets,0,active);PipeBarrier<PIPE_V>();
            Cast(y_,residual_,RoundMode::CAST_NONE,active);PipeBarrier<PIPE_V>();
            // The previous output can drain while this input is consumed.
            // Refill its X slot only after that actual output DMA has finished.
            if(row>begin_ && row+batch_<end_) {
                const uint32_t previous=slot^1;
                WaitFlag<HardEvent::MTE3_MTE2>(previous);pending[previous]=false;
                CopyX(row+batch_,previous);
            }
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                Duplicate(y_[d_/64*64],0.0f,tail,count,1,stride_/8);
                PipeBarrier<PIPE_V>();
            }
            // Residual is dead after Add. TMP can now overwrite its storage.
            Mul(tmp_,y_,y_,active);PipeBarrier<PIPE_V>();
            BlockReduceSum(work_,tmp_,active/64,64,1,1,8);PipeBarrier<PIPE_V>();
            // TMP is dead after its reduction. Refill the following residual
            // while RMS, normalization and affine consume other regions.
            if(row+batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(2);WaitFlag<HardEvent::V_MTE2>(2);
                CopyResidual(row+batch_);
            }
            WholeReduceSum(sums_,work_,static_cast<int32_t>(parts*8),count,1,1,parts);
            PipeBarrier<PIPE_V>();
            Muls(sums_,sums_,invD_,count);PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count);Duplicate(work_,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count);PipeBarrier<PIPE_V>();
            Brcb(work_,sums_,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
            if(count<=parts) {
                for(uint32_t i=0;i<count;++i)
                    Mul(y_[i*stride_],y_[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
            } else {
                const uint8_t step=static_cast<uint8_t>(stride_/8);
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y_[col],y_[col],work_,Min(64,d_-col),count,{1,1,0,step,step,1});
            }
            PipeBarrier<PIPE_V>();
            // X input has been fully consumed; use its slot as the output.
            Cast(x_[slot],y_,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
            if(row==begin_)WaitFlag<HardEvent::MTE2_V>(3);
            const uint32_t halfParts=(d_+127)/128;
            if(count<=halfParts) {
                for(uint32_t i=0;i<count;++i)
                    FusedMulAdd(x_[slot][i*stride_],gh_,bh_,d_);
            } else {
                for(uint32_t col=0;col<d_;col+=128)
                    FusedMulAdd(x_[slot][col],gh_[col],bh_[col],Min(128,d_-col),count,
                        {1,1,1,static_cast<uint8_t>(stride_/16),0,0});
            }
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
            DataCopyExtParams output={static_cast<uint16_t>(count),d_*2,Gap(),0,0};
            DataCopyPad(ogm_[row*d_],x_[slot],output);
            SetFlag<HardEvent::MTE3_MTE2>(slot);pending[slot]=true;
        }
        // Every output is complete before the kernel returns, including
        // one/two-packet tails where neither slot is subsequently refilled.
        if(pending[0])WaitFlag<HardEvent::MTE3_MTE2>(0);
        if(pending[1])WaitFlag<HardEvent::MTE3_MTE2>(1);
    }
    __aicore__ inline void PrepareOffsets()
    {
        // One invocation-local column grid, reused for each input packet.
        for(uint32_t col=0;col<64;++col)
            offsets_.SetValue(col,static_cast<int32_t>(col*2));
        SetFlag<HardEvent::S_V>(3);WaitFlag<HardEvent::S_V>(3);
        for(uint32_t col=64;col<stride_;col+=64)
            Adds(offsets_[col],offsets_,static_cast<int32_t>(col*2),64);
        PipeBarrier<PIPE_V>();
        if(d_!=stride_) {
            uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
            Duplicate(offsets_[d_/64*64],static_cast<int32_t>((d_-1)*2),tail,1,1,8);
            PipeBarrier<PIPE_V>();
        }
        for(uint32_t row=1;row<batch_;++row)
            Adds(offsets_[row*stride_],offsets_,static_cast<int32_t>(row*d_*2),stride_);
        PipeBarrier<PIPE_V>();
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*2-(d_*2+31)/32*32)/32;}
    __aicore__ inline void CopyX(uint64_t row,uint32_t slot)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams cp={1,count*d_*2,0,0,0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(x_[slot],xgm_[row*d_],cp,pad);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    __aicore__ inline void CopyResidual(uint64_t row)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams cp={1,count*d_*2,0,0,0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(residual_,rgm_[row*d_],cp,pad);
        SetFlag<HardEvent::MTE2_V>(2);
    }
    GlobalTensor<half> xgm_,rgm_,ggm_,bgm_,ogm_;
    LocalTensor<half> x_[2],residual_,gh_,bh_;
    LocalTensor<float> y_,tmp_,work_,sums_;
    LocalTensor<int32_t> offsets_;
    uint64_t begin_,end_;
    uint32_t d_,stride_,batch_;
    float invD_,eps_;
};
__global__ __vector__ void half_medium_dense_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState();HalfMediumDenseKernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

// FP16 medium rows: two X slots, one residual aliased with square scratch,
// and output in the consumed X slot. All lifetimes are explicitly fenced.
class HalfWideShared6Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR r,GM_ADDR g,GM_ADDR b,GM_ADDR o,
        uint64_t rows,uint32_t d,float invD,float eps)
    {
        d_=d;stride_=(d+63)/64*64;batch_=15232/stride_;invD_=invD;eps_=eps;
        begin_=rows*GetBlockIdx()/GetBlockNum();
        end_=rows*(GetBlockIdx()+1)/GetBlockNum();
        xgm_.SetGlobalBuffer((__gm__ half*)x);rgm_.SetGlobalBuffer((__gm__ half*)r);
        ConfigureLargeInputCache(xgm_,rgm_,rows,d);
        ggm_.SetGlobalBuffer((__gm__ half*)g);bgm_.SetGlobalBuffer((__gm__ half*)b);
        ogm_.SetGlobalBuffer((__gm__ half*)o);
        x_[0]=LocalTensor<half>(TPosition::VECIN,0,15232);
        x_[1]=LocalTensor<half>(TPosition::VECIN,30592,15232);
        tmp_=LocalTensor<float>(TPosition::VECCALC,61184,15232);
        residual_=tmp_.ReinterpretCast<half>();
        y_=LocalTensor<float>(TPosition::VECCALC,122240,15232);
        gh_=LocalTensor<half>(TPosition::VECIN,183296,1024);
        bh_=LocalTensor<half>(TPosition::VECIN,185472,1024);
        work_=LocalTensor<float>(TPosition::VECCALC,187648,1904);
        sums_=LocalTensor<float>(TPosition::VECCALC,195392,64);
    }
    __aicore__ inline void Process()
    {
        if(begin_>=end_)return;
        CopyX(begin_,0);CopyResidual(begin_);
        if(begin_+batch_<end_)CopyX(begin_+batch_,1);
        DataCopyExtParams cp={1,d_*2,0,0,0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(gh_,ggm_,cp,pad);DataCopyPad(bh_,bgm_,cp,pad);
        SetFlag<HardEvent::MTE2_V>(3);
        bool pending[2]={false,false};
        uint32_t slot=0;
        for(uint64_t row=begin_;row<end_;row+=batch_,slot^=1) {
            WaitFlag<HardEvent::MTE2_V>(slot);WaitFlag<HardEvent::MTE2_V>(2);
            const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
            const uint32_t active=count*stride_,parts=stride_/64;
            Add(x_[slot],x_[slot],residual_,active);PipeBarrier<PIPE_V>();
            Cast(y_,x_[slot],RoundMode::CAST_NONE,active);PipeBarrier<PIPE_V>();
            // Drain the previous output only when its slot is needed again.
            if(row>begin_ && row+batch_<end_) {
                const uint32_t previous=slot^1;
                WaitFlag<HardEvent::MTE3_MTE2>(previous);pending[previous]=false;
                CopyX(row+batch_,previous);
            }
            if(d_!=stride_) {
                uint64_t tail[2]={~static_cast<uint64_t>(0)<<(d_%64),0};
                Duplicate(y_[d_/64*64],0.0f,tail,count,1,stride_/8);
                PipeBarrier<PIPE_V>();
            }
            // Residual is dead after Add. TMP can now overwrite its storage.
            Mul(tmp_,y_,y_,active);PipeBarrier<PIPE_V>();
            BlockReduceSum(work_,tmp_,active/64,64,1,1,8);PipeBarrier<PIPE_V>();
            // TMP is dead after its reduction. Refill the following residual
            // while RMS, normalization and affine consume other regions.
            if(row+batch_<end_) {
                SetFlag<HardEvent::V_MTE2>(2);WaitFlag<HardEvent::V_MTE2>(2);
                CopyResidual(row+batch_);
            }
            const uint32_t partialRow=parts*8;
            if(partialRow>64) {
                Add(work_,work_,work_[64],partialRow-64,count,
                    {1,1,1,static_cast<uint8_t>(parts),static_cast<uint8_t>(parts),static_cast<uint8_t>(parts)});
                PipeBarrier<PIPE_V>();
            }
            WholeReduceSum(sums_,work_,Min(64,partialRow),count,1,1,parts);
            PipeBarrier<PIPE_V>();
            Muls(sums_,sums_,invD_,count);PipeBarrier<PIPE_V>();
            Adds(sums_,sums_,eps_,count);PipeBarrier<PIPE_V>();
            Sqrt(sums_,sums_,count);Duplicate(work_,1.0f,count);PipeBarrier<PIPE_V>();
            Div(sums_,work_,sums_,count);PipeBarrier<PIPE_V>();
            Brcb(work_,sums_,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
            if(count<=parts) {
                for(uint32_t i=0;i<count;++i)
                    Mul(y_[i*stride_],y_[i*stride_],work_[i*8],64,parts,{1,1,0,8,8,0});
            } else {
                const uint8_t step=static_cast<uint8_t>(stride_/8);
                for(uint32_t col=0;col<d_;col+=64)
                    Mul(y_[col],y_[col],work_,Min(64,d_-col),count,{1,1,0,step,step,1});
            }
            PipeBarrier<PIPE_V>();
            // X input has been fully consumed; use its slot as the output.
            Cast(x_[slot],y_,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
            if(row==begin_)WaitFlag<HardEvent::MTE2_V>(3);
            const uint32_t halfParts=(d_+127)/128;
            if(count<=halfParts) {
                for(uint32_t i=0;i<count;++i)
                    FusedMulAdd(x_[slot][i*stride_],gh_,bh_,d_);
            } else {
                for(uint32_t col=0;col<d_;col+=128)
                    FusedMulAdd(x_[slot][col],gh_[col],bh_[col],Min(128,d_-col),count,
                        {1,1,1,static_cast<uint8_t>(stride_/16),0,0});
            }
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
            DataCopyExtParams output={static_cast<uint16_t>(count),d_*2,Gap(),0,0};
            DataCopyPad(ogm_[row*d_],x_[slot],output);
            SetFlag<HardEvent::MTE3_MTE2>(slot);pending[slot]=true;
        }
        if(pending[0])WaitFlag<HardEvent::MTE3_MTE2>(0);
        if(pending[1])WaitFlag<HardEvent::MTE3_MTE2>(1);
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
    __aicore__ inline uint32_t Gap(){return (stride_*2-(d_*2+31)/32*32)/32;}
    __aicore__ inline void CopyX(uint64_t row,uint32_t slot)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams cp={static_cast<uint16_t>(count),d_*2,0,Gap(),0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(x_[slot],xgm_[row*d_],cp,pad);
        SetFlag<HardEvent::MTE2_V>(slot);
    }
    __aicore__ inline void CopyResidual(uint64_t row)
    {
        const uint32_t count=Min(batch_,static_cast<uint32_t>(end_-row));
        DataCopyExtParams cp={static_cast<uint16_t>(count),d_*2,0,Gap(),0};
        DataCopyPadExtParams<half> pad={};pad.isPad=false;
        DataCopyPad(residual_,rgm_[row*d_],cp,pad);
        SetFlag<HardEvent::MTE2_V>(2);
    }
    GlobalTensor<half> xgm_,rgm_,ggm_,bgm_,ogm_;
    LocalTensor<half> x_[2],residual_,gh_,bh_;
    LocalTensor<float> y_,tmp_,work_,sums_;
    uint64_t begin_,end_;
    uint32_t d_,stride_,batch_;
    float invD_,eps_;
};
__global__ __vector__ void half_wide_shared6_custom(GM_ADDR x,GM_ADDR r,GM_ADDR g,
    GM_ADDR b,GM_ADDR out,uint64_t rows,uint32_t d,float invD,float eps)
{
    InitSocState();HalfWideShared6Kernel op;op.Init(x,r,g,b,out,rows,d,invD,eps);op.Process();
}

} // namespace addrmsnormbias_solution

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    using namespace addrmsnormbias_solution;
    const TensorInfo& input = info_x.tensors[0];
    const uint32_t d = static_cast<uint32_t>(input.shape[input.numDims - 1]);
    uint64_t rows = 1;
    for (int64_t i = 0; i + 1 < input.numDims; ++i) {
        rows *= static_cast<uint64_t>(input.shape[i]);
    }
    if (rows == 0 || d == 0 || availableCoreNum <= 0) return;
    const uint32_t blockNum = static_cast<uint32_t>(
        rows < static_cast<uint64_t>(availableCoreNum) ? rows : availableCoreNum);
    const uint32_t limit = input.dtype == 0 ? 4096 : 8192;
    const bool groupRows = (d <= 512 || d == 1024) && rows >= static_cast<uint64_t>(blockNum) * 4;
    // E012 B24: capacity override only within the original FP16 batched route.
    const bool batch24 = groupRows && input.dtype == 1 && d >= 321 && d <= 512;
    const uint32_t capacity = groupRows && input.dtype != 0 && d == 64 && rows >= 8192 ? 4096 :
        groupRows && input.dtype == 2 && d == 128 ? 12288 :
        groupRows && input.dtype == 1 && d == 1024 ? 13312 :
        batch24 ? 24 * ((d + 63) / 64 * 64) :
        (groupRows ? limit : (d <= limit ? (d + 63) / 64 * 64 : 4096));
    // The inverse dimension depends only on shape metadata. Compute it once
    // on the host, leaving every tensor operation on the NPU.
    const float inverseD = 1.0f / static_cast<float>(d);
    if(input.dtype==1 && d>=513 && d<=768 &&
       rows>=static_cast<uint64_t>(blockNum)*4) {
        half_wide_shared6_custom<<<blockNum,nullptr,stream>>>(
            x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }

    if(input.dtype==1 && d>=321 && d<=448 && d%16!=0 &&
       rows>=static_cast<uint64_t>(blockNum)*4) {
        half_medium_dense_custom<<<blockNum,nullptr,stream>>>(
            x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }

    if(input.dtype==1 && d>=193 && d<=256 && d%16!=0 &&
       rows>=static_cast<uint64_t>(blockNum)*4 &&
       rows<=static_cast<uint64_t>(blockNum)*32) {
        half_grid_seed64_custom<<<blockNum,nullptr,stream>>>(
            x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }

    if (input.dtype == 0 && rows >= 2 && rows <= 8 && d <= 512) {
        if (d % 64 == 0) {
            raw_few_float_custom<float, true><<<blockNum, nullptr, stream>>>(
                x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        } else {
            raw_few_float_custom<float><<<blockNum, nullptr, stream>>>(
                x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        }
        return;
    }

    if(input.dtype==1 && d>1024 && d<=4096 && rows>=static_cast<uint64_t>(blockNum)*4) {
        half_wide_pipeline_custom<half,false><<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    if(input.dtype==0 && d>1536 && d<=4096 && rows>=static_cast<uint64_t>(blockNum)*4) {
        float_broad_triple_custom<<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    if(input.dtype==2 && d>1024 && d<=4096 && rows>=static_cast<uint64_t>(blockNum)*8) {
        bfloat_triple_inplace_custom<<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    if (rows >= static_cast<uint64_t>(blockNum)*4 && ((input.dtype==1 && d>=321 && d<=1024) || (input.dtype==2 && d==128))) {
        if(input.dtype==1) pipeline_batch9_custom<half,true><<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        else bfloat_short_inplace_custom<<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,epsilon);
        return;
    }
    if (input.dtype == 1 && d <= 256 && rows >= static_cast<uint64_t>(blockNum)*4 &&
        rows <= static_cast<uint64_t>(blockNum)*32) {
        static_half_rows_custom<<<blockNum,nullptr,stream>>>(
            x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    const uint32_t shortFloatCores=blockNum<8?blockNum:8;
    if(input.dtype==0 && d<=512 && rows>=static_cast<uint64_t>(blockNum)*2 &&
        rows<=static_cast<uint64_t>(shortFloatCores)*(8192/((d+63)/64*64))) {
        short_float_partition_custom<<<shortFloatCores,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    if (input.dtype == 0 && rows >= static_cast<uint64_t>(blockNum) * 2 && rows < static_cast<uint64_t>(blockNum) * 4 && d <= 512) {
        tiny_batch_float_custom<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
        return;
    }

    if (input.dtype == 1 && rows >= static_cast<uint64_t>(blockNum)*4 &&
        d > 512 && d <= 1023) {
        multi_row_wide_custom<half><<<blockNum,nullptr,stream>>>(
            x,residual,gamma,bias,output,rows,d,8192,inverseD,epsilon);
        return;
    }
    if (input.dtype == 0 && rows >= static_cast<uint64_t>(blockNum)*4 &&
        d >= 2048 && d <= 3136) {
        multi_row_direct_custom<float><<<blockNum,nullptr,stream>>>(
            x,residual,gamma,bias,output,rows,d,9408,inverseD,epsilon);
        return;
    }
    if(input.dtype==0 && d>8192 && d<=32768) {
        float_resident_long_custom<<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    if(input.dtype==1 && d>8192 && d<=32768) {
        long_half_retained_custom<<<blockNum,nullptr,stream>>>(x,residual,gamma,bias,output,rows,d,inverseD,epsilon);
        return;
    }
    if (d > limit && d <= 32768) {
        if (input.dtype == 0) {
            retained_long_row_custom<float><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, 4096, inverseD, epsilon);
        } else if (input.dtype == 1) {
            retained_long_row_custom<half><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, 4096, inverseD, epsilon);
        } else if (input.dtype == 2) {
            retained_long_row_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, 4096, inverseD, epsilon);
        }
        return;
    }
    if (rows >= static_cast<uint64_t>(blockNum) * 4 && d > 512 && d != 1024 && d <= 4096) {
        if (input.dtype == 0) {
            whole_rows_static_db_custom<float><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
        } else if (input.dtype == 1) {
            whole_rows_static_db_custom<half><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
        } else if (input.dtype == 2) {
            whole_rows_static_db_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
        }
        return;
    }
    if (rows > 1 && rows < static_cast<uint64_t>(blockNum) * 4 && d <= 4096) {
        if (input.dtype == 0) {
            if (d % 64 == 0) {
                small_rows_static_custom<float, true><<<blockNum, nullptr, stream>>>(
                    x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
            } else {
                small_rows_static_custom<float><<<blockNum, nullptr, stream>>>(
                    x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
            }
        } else if (input.dtype == 1) {
            small_rows_static_custom<half><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
        } else if (input.dtype == 2) {
            small_rows_static_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, inverseD, epsilon);
        }
        return;
    }
    if (rows == 1 && d == 64) {
        if (input.dtype == 0) {
            single_row_64_custom<float><<<1, nullptr, stream>>>(
                x, residual, gamma, bias, output, epsilon);
        } else if (input.dtype == 1) {
            e031_case1_cache_custom<<<1, nullptr, stream>>>(
                x, residual, gamma, bias, output, epsilon);
        } else if (input.dtype == 2) {
            single_row_64_custom<bfloat16_t><<<1, nullptr, stream>>>(
                x, residual, gamma, bias, output, epsilon);
        }
        return;
    }
    if (rows == 1 && d > 64 && d <= 4096) {
        if (input.dtype == 0) {
            single_row_static_custom<float><<<1, nullptr, stream>>>(
                x, residual, gamma, bias, output, d, inverseD, epsilon);
        } else if (input.dtype == 1) {
            single_row_static_custom<half><<<1, nullptr, stream>>>(
                x, residual, gamma, bias, output, d, inverseD, epsilon);
        } else if (input.dtype == 2) {
            single_row_static_custom<bfloat16_t><<<1, nullptr, stream>>>(
                x, residual, gamma, bias, output, d, inverseD, epsilon);
        }
        return;
    }
    if (input.dtype == 0) {
        add_rms_norm_bias_custom<float><<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, capacity, inverseD, epsilon);
    } else if (input.dtype == 1) {
        add_rms_norm_bias_custom<half><<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, capacity, inverseD, epsilon);
    } else if (input.dtype == 2) {
        add_rms_norm_bias_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, capacity, inverseD, epsilon);
    }
}
