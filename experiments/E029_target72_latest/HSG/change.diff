+        const uint32_t active = count_ * stride_;
+        const uint32_t gap = (stride_*2 - (d_*2+31)/32*32)/32;
+        DataCopyExtParams batch = {static_cast<uint16_t>(count_),d_*2,0,gap,0};
+        DataCopyExtParams params = {1,d_*2,0,0,0};
+        DataCopyPadExtParams<half> pad = {}; pad.isPad = false;
+        // Read each per-core partition contiguously. The packed residual Add
+        // is complete before its raw buffer is reused as padded row storage.
+        DataCopyExtParams flat={1,count_*d_*2,0,0,0};
+        DataCopyPad(x_,xgm_[begin_*d_],flat,pad);
+        DataCopyPad(r_,rgm_[begin_*d_],flat,pad);
+        DataCopyPad(gh_,ggm_,params,pad);DataCopyPad(bh_,bgm_,params,pad);
+        SetFlag<HardEvent::MTE2_V>(0);
+        // One shared 256-entry byte-offset vector, not count_*stride_ indices.
+        for(uint32_t i=0;i<8;++i) indices_.SetValue(i,static_cast<int32_t>(i*2));
+        SetFlag<HardEvent::S_V>(0);WaitFlag<HardEvent::S_V>(0);
+        for(uint32_t span=8;span<256;span*=2) {
+            Adds(indices_[span],indices_,static_cast<int32_t>(span*2),span);
+            PipeBarrier<PIPE_V>();
+        }
+        WaitFlag<HardEvent::MTE2_V>(0);
+        Add(x_,x_,r_,count_*d_);PipeBarrier<PIPE_V>();
+        for(uint32_t row=0;row<count_;++row)
+            Gather(r_[row*stride_],x_,indices_.ReinterpretCast<uint32_t>(),row*d_*2,stride_);
+        PipeBarrier<PIPE_V>();
+        ToFloat<half>(y_,r_,active);PipeBarrier<PIPE_V>();
+        if(d_!=stride_) {
+            uint64_t tail[2] = {~static_cast<uint64_t>(0) << (d_%64),0};
+            Duplicate(y_[d_/64*64],0.0f,tail,static_cast<uint8_t>(count_),1,
+                static_cast<uint8_t>(stride_/8)); PipeBarrier<PIPE_V>();
+        }
+        Mul(tmp_,y_,y_,active); PipeBarrier<PIPE_V>();
